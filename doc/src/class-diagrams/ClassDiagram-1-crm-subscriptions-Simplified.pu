@startuml
scale max 4096x4096
hide circle
hide empty fields
hide <<enum>> empty members
skinparam classAttributeIconSize 0

' --- Styling ---
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
    ArrowColor #2B3E6A
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    FontColor #1E293B
}

' ==========================================================
' 1) PRESENTATION LAYER (BOUNDARIES)
' ==========================================================
package "com.invoicingsystem.presentation" {
    class CustomerManagementView <<boundary>> {
        + handleCustomerRegistration(data: CustomerRegistrationData): void
        + handleSubscriptionSetup(customerId: String, planId: String, startDate: LocalDate): void
        + handleCommercialException(subId: String, type: String, val: BigDecimal): void
        + handleCancellationRequest(customerId: String, reason: String): void
        + handleContactAnonymization(contactId: String): void
    }

    class PortalDashboardView <<boundary>> {
        + displayDashboard(): void
    }
}

' ==========================================================
' 2) APPLICATION LOGIC LAYER (CONTROLS & SERVICES)
' ==========================================================
package "com.invoicingsystem.application" {
    class CustomerSubscriptionController <<control>> {
        - notificationGateway: NotificationGateway
        - fileStorage: FileStorageGateway
        - auditService: AuditTrailService
        + registerCustomer(name: String, taxId: String, email: String, country: String): Customer
        + addContact(customerId: String, contact: Contact): boolean
        + anonymizeContact(contactId: String): boolean
        + createSubscription(customerId: String, plan: BillingPlan, startDate: LocalDate): Subscription
        + proposeCommercialException(subId: String, type: String, val: BigDecimal): CommercialException
        + approveCommercialException(exceptionId: String, approver: User, approved: boolean): boolean
        + requestCancellation(customerId: String, user: User, reason: String): CancellationRequest
        + processCancellation(requestId: String, approver: User, approved: boolean): boolean
        + getCustomerTimeline(customerId: String): List<CustomerTimelineEntry>
    }

    class AuditTrailService <<service>> {
        + logOperation(actor: User, action: String, targetEntity: String, details: String): void
    }
}

' ==========================================================
' 3) DOMAIN LAYER (ENTITIES, ENUMS & PORTS)
' ==========================================================
package "com.invoicingsystem.domain" {

    enum CustomerStatus {
        PENDING_VERIFICATION
        ACTIVE
        SUSPENDED
        CANCELLED
    }

    enum AccountStanding {
        UP_TO_DATE
        OVERDUE
        SUSPENDED
        IN_DISPUTE
    }

    enum ContactState {
        ACTIVE
        INACTIVE
        ANONYMIZED
    }

    enum ApprovalStatus {
        PENDING
        APPROVED
        REJECTED
    }

    class Customer {
        - customerId: String
        - legalName: String
        - commercialName: String
        - taxId: String
        - companyEmail: String
        - status: CustomerStatus
        - standing: AccountStanding
        - tags: List<String>
        + hasCompleteTaxInfo(): boolean
        + getOutstandingBalance(): BigDecimal
        + updateStanding(standing: AccountStanding): void
        + addContact(contact: Contact): void
        + addSubscription(sub: Subscription): void
    }

    class Contact {
        - contactId: String
        - name: String
        - email: String
        - phone: String
        - isBillingContact: boolean
        - state: ContactState
        + anonymize(): void
        + deactivate(): void
    }

    class BillingPlan {
        - planId: String
        - name: String
        - basePrice: BigDecimal
        - minPrice: BigDecimal
        - maxPrice: BigDecimal
    }

    class Subscription {
        - subscriptionId: String
        - startDate: LocalDate
        - billingAnchorDay: int
        - paymentTermsDays: int
        - price: BigDecimal
        - active: boolean
        + getPriceOn(date: LocalDate): BigDecimal
        + applyPriceReview(review: PriceReview): void
        + activate(): boolean
        + cancel(): void
    }

    class CommercialException {
        - exceptionId: String
        - type: String
        - discountValue: BigDecimal
        - startDate: LocalDate
        - endDate: LocalDate
        - status: ApprovalStatus
        + approve(reviewer: User): void
        + reject(reviewer: User): void
    }

    class CancellationRequest {
        - requestId: String
        - requestDate: LocalDate
        - reason: String
        - status: ApprovalStatus
        + approve(reviewer: User): void
        + reject(reviewer: User): void
    }

    class PriceReview {
        - reviewId: String
        - proposedPrice: BigDecimal
        - approvedPrice: BigDecimal
        - effectiveFrom: LocalDate
        - status: ApprovalStatus
        + approve(reviewer: User, finalPrice: BigDecimal): void
    }

    ' Reference entities from other subsystems
    class User {
        - userId: String
        - email: String
        + hasPermission(perm: String): boolean
    }

    class Invoice {
        - invoiceNumber: String
        - status: String
    }

    ' Outbound ports
    interface NotificationGateway <<interface>> {
        + sendNotification(email: String, subject: String, body: String): boolean
    }

    interface FileStorageGateway <<interface>> {
        + storeFile(name: String, content: byte[]): String
    }
}

' ==========================================================
' 4) INFRASTRUCTURE LAYER
' ==========================================================
package "com.invoicingsystem.infrastructure" {
    class SecureCloudFileStorageAdapter {
        + storeFile(name: String, content: byte[]): String
    }
    class SmtpNotificationAdapter {
        + sendNotification(email: String, subject: String, body: String): boolean
    }
}

' ==========================================================
' 5) RELATIONSHIPS
' ==========================================================
CustomerManagementView ..> CustomerSubscriptionController
PortalDashboardView ..> CustomerSubscriptionController

CustomerSubscriptionController ..> Customer
CustomerSubscriptionController ..> Subscription
CustomerSubscriptionController ..> NotificationGateway
CustomerSubscriptionController ..> FileStorageGateway
CustomerSubscriptionController ..> AuditTrailService

Customer "1" *-- "1..*" Contact : contacts
Customer "1" *-- "0..*" Subscription : subscriptions
Customer "1" *-- "0..*" CancellationRequest : cancellations
Customer "1" --> "0..*" Invoice : invoices

Subscription "0..*" --> "1" BillingPlan : plan
Subscription "1" *-- "0..*" CommercialException : exceptions
Subscription "1" *-- "0..*" PriceReview : reviews

CancellationRequest "0..*" --> "1" User : requestedBy
CancellationRequest "0..*" --> "0..1" User : reviewedBy
CommercialException "0..*" --> "1" User : proposedBy
CommercialException "0..*" --> "0..1" User : approvedBy

FileStorageGateway <|.. SecureCloudFileStorageAdapter
NotificationGateway <|.. SmtpNotificationAdapter

@enduml
