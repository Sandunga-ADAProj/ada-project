@startuml
scale max 4096x4096
hide circle
hide empty fields
hide <<enum>> empty members
skinparam classAttributeIconSize 0

' Class styling
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

' ==========================================
' 1) PRESENTATION LAYER (BOUNDARIES)
' ==========================================
package "com.invoicingsystem.presentation" {
    class PortalDashboardSummaryView <<boundary>> {
        + renderLoginForm(): void
        + renderDashboardSummary(dashboard: DashboardSummary): void
        + renderSearchResults(records: List<SearchResult>): void
        + onSavePreferencesClicked(prefs: UserPreferences): void
        + onLoginClicked(email: String, password: String): void
        + onAddFavoriteClicked(reference: EntityReference): void
        + onRemoveFavoriteClicked(reference: EntityReference): void
        + renderFavorites(records: List<EntityReference>): void
        + renderRecentlyViewed(records: List<EntityReference>): void
        + onDelegateAccessClicked(grantee: User, scope: Customer, validUntil: LocalDate): void
        + renderDelegationSuccess(delegation: AccountDelegation): void
        + onRevokeDelegationClicked(delegationId: String): void
        + onLogoutClicked(sessionId: String): void
    }
    class CustomerManagementView <<boundary>> {
        + renderRegistrationForm(): void
        + renderContactsList(contacts: List<Contact>): void
        + renderSubscriptionSetup(plans: List<BillingPlan>): void
        + onRequestCancellationClicked(customerId: String, reason: String): void
        + onRegisterCustomerClicked(data: CustomerRegistrationData): void
        + onVerifyCompanyEmailClicked(customerId: String, token: String): void
        + onAnonymizeContactClicked(customerId: String, targetContactId: String): void
        + onSetupSubscriptionClicked(customerId: String, planId: String, futureStartDate: LocalDate): void
        + renderSubscriptionSetup(subscription: Subscription): void
        + onProposeExceptionClicked(subId: String, type: String, value: BigDecimal): void
        + renderExceptionSubmitted(ex: CommercialException): void
        + onProcessExceptionClicked(exceptionId: String, approved: boolean): void
        + renderCancellationSubmitted(req: CancellationRequest): void
        + onReviewCancellationClicked(requestId: String): void
        + onProcessCancellationClicked(requestId: String, approved: boolean): void
        + renderCancellationReview(summary: CancellationReviewSummary): void
        + renderCancellationProcessed(approved: boolean): void
        + onUploadCustomerAttachmentClicked(customerId: String, file: AttachmentUploadRequest): void
        + onCustomerTimelineClicked(customerId: String): void
        + renderCustomerTimeline(customer: Customer, events: List<CustomerTimelineEntry>): void
    }
    class InvoicingAndReconciliationView <<boundary>> {
        + renderInvoiceDetails(invoice: Invoice, comments: List<Comment>): void
        + onIssueInvoiceClicked(invoiceNumber: String): void
        + renderUnmatchedPayments(transactions: List<BankTransaction>): void
        + onExportPackageClicked(period: FinancialPeriod, filters: Map<String, String>): void
        + renderExportDownload(pkg: AccountingExportPackage): void
        + onDeleteTestInvoiceClicked(testInvoiceNumber: String): void
        + renderInvoiceDeleted(): void
        + onResolveUnmatchedClicked(bankTxId: String, selectedInvoiceId: String): void
        + onAddCommentClicked(invoiceNumber: String, text: String): void
        + onUploadInvoiceAttachmentClicked(invoiceNumber: String, file: AttachmentUploadRequest): void
    }

    class SystemAdministrationView <<boundary>> {
        + renderPricingConfiguration(plans: List<BillingPlan>): void
        + renderFlaggedPricesQueue(reviews: List<PriceReview>): void
        + renderUserPermissions(): void
        + onOverridePeriodClicked(period: FinancialPeriod, reason: String): void
        + renderCustomRoles(roles: List<AccessRole>): void
        + onCreateRoleClicked(name: String, permissions: Set<String>): void
        + onAssignRoleClicked(userId: String, roleId: String): void
        + onAssignSubstituteClicked(primaryId: String, substituteId: String, scope: String, validUntil: LocalDate): void
        + renderSubstituteAssignments(assignments: List<SubstituteApproverAssignment>): void
        + renderAnnualPricingReviews(reviews: List<PriceReview>): void
        + onApproveAnnualReviewClicked(reviewId: String, approvedPrice: BigDecimal, effectiveFrom: LocalDate): void
        + renderNotificationRules(rules: List<NotificationRule>): void
        + renderBusinessRules(rules: List<BusinessRule>): void
    }
}

' ==========================================
' 2) APPLICATION LOGIC LAYER (CONTROLS)
' ==========================================
package "com.invoicingsystem.application" {
    class CustomerAndSubscriptionController <<control>> {
        - notifier: NotificationGateway
        - auditTrail: AuditTrailService
        - attachments: AttachmentService
        - auditRead: AuditRecordRepository
        + registerCustomer(admin: Admin, data: CustomerRegistrationData): Customer
        + manageContacts(admin: Admin, customer: Customer): boolean
        + setCustomerTags(admin: Admin, customer: Customer, tags: List<String>): boolean
        + getCustomerTimeline(user: User, customer: Customer): List<CustomerTimelineEntry>
        + uploadCustomerAttachment(admin: Admin, customer: Customer, file: AttachmentUploadRequest): DocumentAttachment
        + verifyCompanyEmail(customerId: String, token: String): boolean
        + anonymizeContactData(admin: Admin, targetContact: Contact): boolean
        + configureSubscription(admin: Admin, customer: Customer, plan: BillingPlan, startDate: LocalDate): Subscription
        + submitCommercialException(user: User, sub: Subscription, type: String, val: BigDecimal): CommercialException
        + approveCommercialException(approver: Admin, ex: CommercialException, approved: boolean): boolean
        + handleCancellationWorkflow(user: User, customer: Customer, reason: String): CancellationRequest
        + getCancellationReview(admin: Admin, req: CancellationRequest): CancellationReviewSummary
        + processCancellationRequest(admin: Admin, req: CancellationRequest, approved: boolean): boolean
        - detectPotentialDuplicates(taxId: String, legalName: String): List<Customer>
        - generateVerificationToken(customer: Customer): String
        - buildVerificationLink(token: String): String
        - validateVerificationToken(customerId: String, token: String): boolean
        - checkAnonymizationAllowed(customer: Customer, targetContact: Contact): boolean
        - calculateDiscountedPrice(sub: Subscription, discountFraction: BigDecimal): BigDecimal
        - hasRequiredApprovalAuthority(approver: Admin, ex: CommercialException): boolean
        - validateCancellationRequest(user: User, customer: Customer): boolean
        - prepareMinimumAuthorizedAccountDetails(customer: Customer): CancellationReviewSummary
        - validateCancellationDecision(admin: Admin, req: CancellationRequest): boolean
    }
    class InvoicingAndBillingController <<control>> {
        - notifier: NotificationGateway
        - calendarService: BusinessCalendarService
        - auditTrail: AuditTrailService
        - attachments: AttachmentService
        - notificationRepository: NotificationRepository
        + executeRecurringBillingBatch(executionDate: LocalDate): void
        + processScheduledReminders(executionDate: LocalDate): void
        + uploadInvoiceAttachment(admin: Admin, invoice: Invoice, file: AttachmentUploadRequest): DocumentAttachment
        + resolveUnpaidInvoice(admin: Admin, invoice: Invoice, outcome: CollectionOutcome, reason: String): boolean
        + createOrUpdateAdHocInvoice(admin: Admin, customer: Customer): Invoice
        + issueAndSendInvoice(admin: Admin, invoice: Invoice): Invoice
        + authorizeInvoiceOverride(superAdmin: SuperAdmin, invoice: Invoice, reason: String): boolean
        + postInvoiceComment(user: User, invoice: Invoice, text: String): Comment
        + deleteTestInvoice(admin: Admin, invoice: Invoice): boolean
        + closeFinancialPeriod(admin: Admin, period: FinancialPeriod): boolean
        + generateAccountingExport(admin: Admin, period: FinancialPeriod, filters: Map<String, String>): AccountingExportPackage
        + findAnnualPricingReviews(period: Year): List<PriceReview>
        + approveAnnualPricingReview(admin: Admin, review: PriceReview, approvedPrice: BigDecimal, effectiveFrom: LocalDate): boolean
        - checkBillingEligibility(sub: Subscription, customer: Customer, date: LocalDate): boolean
        - recordSkippedSubscription(sub: Subscription): void
        - invoiceAlreadyExists(sub: Subscription, date: LocalDate): boolean
        - isFinancialPeriodLocked(date: LocalDate): boolean
        - recordBlockedGeneration(sub: Subscription): void
        - nextSequentialInvoiceNumber(): String
        - resolveApplicableTaxRate(customer: Customer, sub: Subscription): BigDecimal
        - validateInvoiceForIssuance(invoice: Invoice): boolean
        - validateSuperAdminPermission(superAdmin: SuperAdmin): boolean
        - nextExportVersion(period: FinancialPeriod): int
        - generateExportFiles(period: FinancialPeriod, filters: Map<String, String>): String
        - collectAnnualPriceReviewSources(customer: Customer): List<String>
        - checkCommentPermission(user: User, invoice: Invoice): boolean
        - resolveMentions(text: String): List<User>
        - findReminderCandidates(runDate: LocalDate): List<Invoice>
        - computeReminderOccurrences(invoice: Invoice, runDate: LocalDate): List<ReminderOccurrence>
        - buildReminderDeduplicationKey(invoice: Invoice, kind: ReminderKind, plannedDate: LocalDate): String
        - scheduleNotificationRetry(notification: Notification): void
        - queueInvoiceNotificationRetry(invoice: Invoice, recipientEmail: String): void
    }
    class ReconciliationController <<control>> {
        - bankingGateway: BankingPaymentGateway
        - notifier: NotificationGateway
        - auditTrail: AuditTrailService
        + runAutomatedReconciliation(): void
        + resolveUnmatchedTransaction(admin: Admin, tx: BankTransaction, invoice: Invoice): boolean
        + allocatePayment(tx: BankTransaction, invoice: Invoice, amount: BigDecimal): PaymentAllocation
        - findMatchingInvoices(reference: String, amount: BigDecimal, metadata: Map<String, String>): List<Invoice>
        - calculateRemainingBalance(invoice: Invoice): BigDecimal
        - validatePaymentAmount(tx: BankTransaction, balance: BigDecimal): boolean
        - updateTransactionCheckpoint(): void
        - validateManualResolution(admin: Admin, tx: BankTransaction, invoice: Invoice): boolean
    }

 
    
    class DashboardSummary <<DTO>> {
        + outstandingBalance: BigDecimal
        + pendingInvoices: int
        + unmatchedPayments: int
    }

    class CancellationReviewSummary <<DTO>> {
        + customerId: String
        + requestReason: String
        + outstandingBalance: BigDecimal
        + authorizedAccountDetails: List<String>
    }

    class CustomerRegistrationData <<DTO>> {
        + commercialName: String
        + tradingName: String
        + legalName: String
        + taxId: String
        + taxAddress: String
        + country: String
        + currency: String
        + companyEmail: String
        + primaryContactName: String
        + primaryContactEmail: String
        + primaryContactPhone: String
    }

    class CustomerTimelineEntry <<DTO>> {
        + occurredAt: LocalDateTime
        + eventType: String
        + description: String
        + actorId: String
        + relatedEntityId: String
    }

    class SearchResult <<DTO>> {
        + entityType: String
        + recordId: String
        + displayLabel: String
    }
    class AccessAndConfigController <<control>> {
        - auditTrail: AuditTrailService
        - sessionManager: SessionManagementService
        + logout(sessionId: String): boolean
        + deactivateUserAccount(admin: Admin, targetUser: User): boolean
        + expireInactiveSessions(now: LocalDateTime): int
        + authenticateUser(email: String, password: String): boolean
        + getDashboardSummary(user: User): DashboardSummary
        + delegateAccountAccess(admin: Admin, originalAssignee: User, grantee: User, scope: Customer, validUntil: LocalDate): AccountDelegation
        + revokeAccountDelegation(admin: Admin, delegation: AccountDelegation): boolean
        + expireDelegations(date: LocalDate): void
        + createCustomRole(superAdmin: SuperAdmin, name: String, permissions: Set<String>): AccessRole
        + assignCustomRole(superAdmin: SuperAdmin, user: User, role: AccessRole): boolean
        + revokeCustomRole(superAdmin: SuperAdmin, user: User, role: AccessRole): boolean
        + assignSubstituteApprover(admin: Admin, primary: Admin, substitute: Admin, scope: String, validUntil: LocalDate): SubstituteApproverAssignment
        + revokeSubstituteApprover(admin: Admin, assignment: SubstituteApproverAssignment): boolean
        + expireSubstituteAssignments(today: LocalDate): void
        + addFavorite(user: User, reference: EntityReference): boolean
        + removeFavorite(user: User, reference: EntityReference): boolean
        + recordRecentlyViewed(user: User, reference: EntityReference): void
        + getFavorites(user: User): List<EntityReference>
        + getRecentlyViewed(user: User): List<EntityReference>
        + updateStandardPricingAndTargets(superAdmin: SuperAdmin, plan: BillingPlan): boolean
        + updatePermissionsAndRules(superAdmin: SuperAdmin, user: User, permissions: Set<String>, rule: BusinessRule): boolean
        - checkAccountStatusAndLockout(email: String): boolean
        - verifyPasswordAgainstStoredHash(email: String, password: String): boolean
        - resetFailedLoginAttempts(email: String): void
        - recordFailedLoginAttempt(email: String): void
        - blockAuthentication(email: String, durationMinutes: int): void
        - validateDelegation(admin: Admin, originalAssignee: User, grantee: User, scope: Customer, validUntil: LocalDate): boolean
        - validateRevocationPermission(admin: Admin, delegation: AccountDelegation): boolean
        - validateSubstituteAuthority(admin: Admin, primary: Admin, substitute: Admin, scope: String): boolean
    }

    class ReminderOccurrence <<DTO>> {
        + invoice: Invoice
        + kind: ReminderKind
        + plannedDate: LocalDate
        + deduplicationKey: String
    }

    class AttachmentUploadRequest <<DTO>> {
        + fileName: String
        + mediaType: String
        + sizeBytes: long
        + content: byte[]
    }

    class AttachmentService <<service>> {
        - storage: FileStorageGateway
        - auditTrail: AuditTrailService
        + uploadForCustomer(admin: Admin, customer: Customer, file: AttachmentUploadRequest): DocumentAttachment
        + uploadForInvoice(admin: Admin, invoice: Invoice, file: AttachmentUploadRequest): DocumentAttachment
        - validateUploadPermissionAndType(admin: Admin, file: AttachmentUploadRequest): boolean
    }

    class AuditTrailService <<service>> {
        - repository: AuditRecordRepository
        + recordChange(entityType: String, entityId: String, actorId: String, oldValue: String, newValue: String): ChangeHistoryRecord
        + persistAuditRecord(record: ChangeHistoryRecord): void
        + recordRejectedOperation(actorId: String, reason: String): void
    }

    class SessionManagementService <<service>> {
        - inactivityTimeoutMinutes: int
        + createSession(user: User, now: LocalDateTime): UserSession
        + recordActivity(sessionId: String, now: LocalDateTime): boolean
        + endSession(sessionId: String): boolean
        + expireInactiveSessions(now: LocalDateTime): int
        + invalidateAllForUser(user: User): int
        + configureInactivityTimeout(minutes: int): void
    }
}

' ==========================================
' 3) CORE DOMAIN LAYER (ENTITIES & CONTRACTS)
' ==========================================
package "com.invoicingsystem.domain" {

    ' --- Enumerations ---
    
    enum UserState {
        ACTIVE
        INACTIVE
        BLOCKED
    }

    enum SubscriptionStatus {
        PENDING_ACTIVATION
        ACTIVE
        SUSPENDED
        CANCELLED
    }


    enum AccountStanding <<enum>> {
        UP_TO_DATE
        OVERDUE
        SUSPENDED
        IN_DISPUTE
    }

    enum ContactState <<enum>> {
        ACTIVE
        INACTIVE
        ANONYMIZED
    }

    enum InvoiceStatus <<enum>> {
        DRAFT
        READY
        ISSUED
        SENT
        OVERDUE
        PAID
        PARTIALLY_RECONCILED
    }

    enum InvoiceType <<enum>> {
        RECURRING
        ONE_OFF
        TEST
    }

    enum ApprovalStatus <<enum>> {
        PENDING
        APPROVED
        REJECTED
    }
    
    enum CustomerStatus {
        PENDING_VERIFICATION
        PENDING_ACTIVATION
        ACTIVE
        SUSPENDED
        CANCELLED
    }
    
    enum DelegationStatus {
        ACTIVE
        EXPIRED
        REVOKED
    }

    enum PriceReviewKind {
        COMMERCIAL_EXCEPTION
        ANNUAL
    }

    enum ReminderKind {
        DAY_3_FOLLOW_UP
        DAY_5_FOLLOW_UP
        PERIODIC_OVERDUE
    }

    enum CollectionOutcome {
        OPEN
        RESOLVED
        WRITTEN_OFF
    }

    enum SessionStatus {
        ACTIVE
        EXPIRED
        REVOKED
    }
  
    class UserPreferences {
        - language: String
        - fontScale: double
        - highContrast: boolean
        - favoriteRecords: List<EntityReference>
        - recentlyViewedRecords: List<EntityReference>
        + addFavorite(reference: EntityReference): void
        + removeFavorite(reference: EntityReference): void
        + recordRecentView(reference: EntityReference): void
    }

    class EntityReference <<value object>> {
        + entityType: String
        + entityId: String
        + displayLabel: String
    }

    class AccessRole {
        - roleId: String
        - name: String
        - description: String
        - permissions: Set<String>
        - enabled: boolean
        - systemRole: boolean
        + updatePermissions(permissions: Set<String>): void
    }

    class SubstituteApproverAssignment {
        - assignmentId: String
        - approvalScope: String
        - assignedAt: LocalDateTime
        - validFrom: LocalDate
        - validUntil: LocalDate
        - status: DelegationStatus
        - reason: String
        + isActive(onDate: LocalDate): boolean
        + expire(): void
        + revoke(): void
    }
    
    class AccountDelegation {
        - delegationId: String
        - startDate: LocalDate
        - validUntil: LocalDate
        - status: DelegationStatus
        + isActive(date: LocalDate): boolean
        + expire(): void
        + revoke(): void
    }
    class PriceReview {
        - reviewId: String
        - kind: PriceReviewKind
        - proposedPrice: BigDecimal
        - previousPrice: BigDecimal
        - approvedPrice: BigDecimal
        - effectiveFrom: LocalDate
        - reviewedAt: LocalDateTime
        - dataSources: List<String>
        - reason: String
        - status: ApprovalStatus
        + setStatus(newStatus: ApprovalStatus): void
        + recordAnnualDecision(approver: Admin, price: BigDecimal, effectiveFrom: LocalDate): void
    }

    class UserSession {
        - sessionId: String
        - tokenHash: String
        - createdAt: LocalDateTime
        - lastActivityAt: LocalDateTime
        - revokedAt: LocalDateTime
        - status: SessionStatus
        + touch(now: LocalDateTime): void
        + isExpired(now: LocalDateTime, inactivityMinutes: int): boolean
        + revoke(): void
    }

    class DocumentAttachment {
        - attachmentId: String
        - fileName: String
        - mediaType: String
        - sizeBytes: long
        - storageKey: String
        - uploadedAt: LocalDateTime
    }

    class ChangeHistoryRecord {
        - recordId: String
        - entityType: String
        - entityId: String
        - changeType: String
        - actorId: String
        - timestamp: LocalDateTime
        - previousValue: String
        - newValue: String
    }

    class NotificationRule {
        - ruleId: String
        - triggerType: String
        - delayDays: int
        - overdueIntervalDays: int
        - enabled: boolean
    }

    class BusinessRule {
        - ruleId: String
        - name: String
        - value: String
        - enabled: boolean
    }
    class AccountingExportPackage {
        - exportId: String
        - version: int
        - generatedAt: LocalDateTime
        - filePath: String
        - requestedBy: User
        - appliedFilters: Map<String, String>
        - period: FinancialPeriod
        - previousVersion: Integer
        + isRegenerated(): boolean
    }




    ' --- Domain Interfaces (Contracts dictated by the business) ---
    interface BankingPaymentGateway <<interface>> {
        + fetchTransactionsSince(checkpoint: LocalDateTime): List<BankTransaction>
        + testConnection(): boolean
    }

    interface NotificationGateway <<interface>> {
        + sendNotification(recipientEmail: String, subject: String, body: String): boolean
        + sendNotification(recipientEmail: String, subject: String, body: String, idempotencyKey: String): boolean
        + scheduleReminder(invoiceNumber: String, sendDate: LocalDate): boolean
    }

    interface BusinessCalendarService <<interface>> {
        + isWorkingDay(date: LocalDate, country: String): boolean
        + getNextWorkingDay(date: LocalDate, country: String): LocalDate
    }

    interface AuditRecordRepository <<interface>> {
        + save(record: ChangeHistoryRecord): void
        + findByEntity(entityType: String, entityId: String): List<ChangeHistoryRecord>
    }

    interface NotificationRepository <<interface>> {
        + findOrCreatePending(invoice: Invoice, kind: ReminderKind, plannedDate: LocalDate, deduplicationKey: String): Notification
        + claimForDispatch(notificationId: String, leaseUntil: LocalDateTime): boolean
        + markSent(notificationId: String, sentAt: LocalDateTime): void
        + markFailed(notificationId: String, nextRetryAt: LocalDateTime): void
    }

    interface FileStorageGateway <<interface>> {
        + scanAndStore(fileName: String, mediaType: String, content: byte[]): String
        + deleteStoredFile(storageKey: String): boolean
    }

    ' --- Entities ---
    class User {
        - userId: String
        - email: String
        - passwordHash: String
        - state: UserState
        - permissions: Set<String>
        - roles: Set<AccessRole>
        - failedLoginAttempts: int
        - lockedUntil: LocalDateTime
        + configureUserPreferences(prefs: UserPreferences): void
        + addComment(invoice: Invoice, text: String): Comment
        + proposeCommercialException(sub: Subscription, type: String, value: BigDecimal): CommercialException
        + requestAccCancellation(customer: Customer, reason: String): CancellationRequest
        + deactivate(): void
        + assignRole(role: AccessRole): void
        + revokeRole(role: AccessRole): void
        + hasPermission(permission: String): boolean
    }

    class Admin {
        + registerCustomerProfile(legalName: String, taxId: String, country: String, companyEmail: String): Customer        
        + manageCustomerContacts(customer: Customer): boolean
        + anonymizeContactData(contact: Contact): boolean
        + setUpSubsPlan(customer: Customer, plan: BillingPlan): Subscription
        + approveCommercialEx(ex: CommercialException): boolean
        + reviewFlaggedPrices(): List<PriceReview>
        + manageAdHocInvoice(customer: Customer): Invoice
        + exportAccPackage(period: FinancialPeriod): AccountingExportPackage
        + issueInvoice(invoice: Invoice): Invoice
        + lockFinancialPeriod(period: FinancialPeriod): boolean
        + reviewUnmatchedPayment(tx: BankTransaction, invoice: Invoice): boolean
        + configNotificationTriggers(rule: NotificationRule): boolean
        + processAccCancellation(req: CancellationRequest): boolean
        + authorizeAccountDelegation(delegation: AccountDelegation): boolean
        + provisionGuestAccount(email: String, validUntil: LocalDate): User
        + designateSubstitute(primary: Admin, substitute: Admin, scope: String, validUntil: LocalDate): SubstituteApproverAssignment
    }

    class SuperAdmin {
        + configStandardPricing(plan: BillingPlan): boolean
        + configStandardTargets(month: YearMonth, target: BigDecimal): boolean
        + configureUserPermissions(user: User, permissions: Set<String>): boolean        
        + manageSystemRules(rule: BusinessRule): boolean
        + overrideLockedPeriod(period: FinancialPeriod, reason: String): boolean
        + defineCustomRole(name: String, permissions: Set<String>): AccessRole
        + assignRoleToUser(user: User, role: AccessRole): boolean
}
    class Customer {
        - customerId: String
        - commercialName: String
        - tradingName: String
        - legalName: String
        - taxId: String
        - taxAddress: String
        - country: String
        - currency: String
        - companyEmail: String
        - emailVerified: boolean
        - status: CustomerStatus
        - standing: AccountStanding
        - tags: List<String>
        + markEmailVerified(): void
        + addContact(contact: Contact): Contact
        + deactivateContact(contact: Contact): boolean
        + addSubscription(subscription: Subscription): boolean
        + getSubscriptions(): List<Subscription>
        + linkInvoice(invoice: Invoice): boolean
        + setStatus(newStatus: CustomerStatus): void
        + setStanding(newStanding: AccountStanding): void
        + hasCompleteTaxInfo(): boolean
        + getOutstandingBalance(): BigDecimal
        + setTags(tags: List<String>): void
    }

    class Contact {
        - contactId: String
        - name: String
        - email: String
        - phone: String
        - isBillingContact: boolean
        - state: ContactState
        + anonymize(): void
    }

    class BillingPlan {
        - name: String
        - basePrice: BigDecimal
        - minPrice: BigDecimal
        - maxPrice: BigDecimal
    }
    class Subscription {
        - subscriptionId: String
        - startDate: LocalDate
        - billingAnchorDay: int
        - paymentTermsDays: int
        - price: BigDecimal
        - status: SubscriptionStatus
        + activate(): boolean
        + setStatus(newStatus: SubscriptionStatus): void
        + setPrice(newPrice: BigDecimal): boolean
        + applyApprovedPriceReview(review: PriceReview, currentDate: LocalDate): boolean
        + getPriceOn(date: LocalDate): BigDecimal
    }
    class Invoice {
        - invoiceNumber: String
        - type: InvoiceType
        - status: InvoiceStatus
        - issueDate: LocalDate
        - dueDate: LocalDate
        - subtotal: BigDecimal
        - vatAmount: BigDecimal
        - total: BigDecimal
        - collectionOutcome: CollectionOutcome
        + changeStatus(newStatus: InvoiceStatus): boolean
        + isEditable(): boolean
        + setIssueDate(date: LocalDate): void
        + populateBillingDetails(customer: Customer): void
        + addInvoiceLine(line: InvoiceLine): void
        + calculateVatAndTotals(): void
        + addComment(comment: Comment): boolean
        + getOutstandingBalance(): BigDecimal
        + isReminderEligible(): boolean
        + setCollectionOutcome(outcome: CollectionOutcome): void
        + dispose(): void
    }

    class InvoiceLine {
        - description: String
        - quantity: int
        - unitPrice: BigDecimal
        - taxRate: BigDecimal
    }

    class Comment {
        - text: String
        - createdAt: LocalDateTime
        - mentions: List<User>
    }
    class CommercialException {
        - type: String
        - value: BigDecimal
        - startDate: LocalDate
        - endDate: LocalDate
        - status: ApprovalStatus
        + approve(): void
        + reject(): void
    }
    class CancellationRequest {
        - requestDate: LocalDate
        - reason: String
        - outstandingBalance: BigDecimal
        - status: ApprovalStatus
        + approve(): void
        + reject(): void
    }
    class BankTransaction {
        - reference: String
        - amount: BigDecimal
        - valueDate: LocalDate
        - status: String
        + setStatus(newStatus: String): void
    }
    class FinancialPeriod {
        - startDate: LocalDate
        - endDate: LocalDate
        - locked: boolean
        - authorizedInvoiceExceptions: Set<String>
        + isLocked(): boolean
        + grantInvoiceException(invoice: Invoice, reason: String): boolean
    }
    
    
    class PaymentAllocation {
        - allocatedAmount: BigDecimal
        - allocationDate: LocalDate

        + validateAmount(): boolean
    }
    class Notification {
        - notificationId: String
        - type: String
        - status: String
        - scheduledAt: LocalDateTime
        - sentAt: LocalDateTime
        - reminderKind: ReminderKind
        - deduplicationKey: String
        - nextRetryAt: LocalDateTime
        - deliveryAttempts: int
        + setStatus(newStatus: String): void
        + setSentAt(time: LocalDateTime): void
    }

}

' ==========================================
' 4) INFRASTRUCTURE LAYER (EXTERNAL ADAPTERS)
' ==========================================
package "com.invoicingsystem.infrastructure" {
    class BankingApiAdapter {
        - apiEndpointUrl: String
        - apiKey: String
        - simulatedStripeMode: boolean
        + fetchTransactionsSince(checkpoint: LocalDateTime): List<BankTransaction>
        + testConnection(): boolean
        - parseBankPayload(rawJson: String): List<BankTransaction>
    }

    class NotificationServiceAdapter {
        - smtpHost: String
        - gatewayApiKey: String
        + sendNotification(recipientEmail: String, subject: String, body: String): boolean
        + sendNotification(recipientEmail: String, subject: String, body: String, idempotencyKey: String): boolean
        + scheduleReminder(invoiceNumber: String, sendDate: LocalDate): boolean
    }

    class RegionalCalendarAdapter {
        - defaultRegion: String
        + isWorkingDay(date: LocalDate, country: String): boolean
        + getNextWorkingDay(date: LocalDate, country: String): LocalDate
    }

    class DatabaseNotificationRepository {
        + findOrCreatePending(invoice: Invoice, kind: ReminderKind, plannedDate: LocalDate, deduplicationKey: String): Notification
        + claimForDispatch(notificationId: String, leaseUntil: LocalDateTime): boolean
        + markSent(notificationId: String, sentAt: LocalDateTime): void
        + markFailed(notificationId: String, nextRetryAt: LocalDateTime): void
    }

    class DatabaseAuditRecordRepository {
        + save(record: ChangeHistoryRecord): void
        + findByEntity(entityType: String, entityId: String): List<ChangeHistoryRecord>
    }

    class SecureFileStorageAdapter {
        - storageRoot: String
        - maxUploadBytes: long
        + scanAndStore(fileName: String, mediaType: String, content: byte[]): String
        + deleteStoredFile(storageKey: String): boolean
        - rejectMaliciousFile(content: byte[]): void
    }
}

