@startuml
scale max 4096x4096
hide circle
hide empty fields
hide <<enum>> empty members
skinparam classAttributeIconSize 0

' --- Styling ---
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
    ArrowColor #2B3E6A
}

skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    FontColor #1E293B
}

' ==========================================================
' 1) PRESENTATION LAYER (BOUNDARIES - LIMPIAS, SIN BOTONES)
' ==========================================================
package "com.invoicingsystem.presentation" {
    class PortalDashboardView <<boundary>> {
        + displayDashboard(summary: DashboardSummary): void
        + handleUserPreferences(prefs: UserPreferences): void
    }

    class CustomerManagementView <<boundary>> {
        + handleCustomerRegistration(data: CustomerRegistrationData): void
        + handleSubscriptionChange(subId: String, planId: String): void
        + handleCancellationRequest(customerId: String, reason: String): void
    }

    class InvoicingAndReconciliationView <<boundary>> {
        + handleInvoiceIssuance(invoiceNumber: String): void
        + handlePaymentReconciliation(txId: String, invoiceId: String): void
        + handleAccountingExport(periodId: String): void
    }

    class SystemAdministrationView <<boundary>> {
        + handleRoleManagement(userId: String, roleId: String): void
        + handlePricingReview(reviewId: String, approved: boolean): void
        + handlePeriodLock(periodId: String, locked: boolean): void
    }
}

' ==========================================================
' 2) APPLICATION LOGIC LAYER (CONTROLLERS / USE CASES)
' ==========================================================
package "com.invoicingsystem.application" {
    class CustomerSubscriptionController <<control>> {
        - customerRepo: CustomerRepository
        - notificationGateway: NotificationGateway
        - auditService: AuditTrailService
        + registerCustomer(data: CustomerRegistrationData): Customer
        + manageContacts(customerId: String, contact: Contact): boolean
        + anonymizeContact(contactId: String): boolean
        + createSubscription(customerId: String, plan: BillingPlan, start: LocalDate): Subscription
        + proposeCommercialException(subId: String, type: String, val: BigDecimal): CommercialException
        + approveCommercialException(exceptionId: String, approved: boolean): boolean
        + requestCancellation(customerId: String, reason: String): CancellationRequest
        + processCancellation(requestId: String, approved: boolean): boolean
    }

    class InvoicingAndBillingController <<control>> {
        - invoiceRepo: InvoiceRepository
        - calendarService: BusinessCalendarService
        - notificationGateway: NotificationGateway
        - auditService: AuditTrailService
        + executeRecurringBillingBatch(executionDate: LocalDate): void
        + issueAndSendInvoice(invoiceNumber: String): Invoice
        + createAdHocInvoice(customerId: String, lines: List<InvoiceLine>): Invoice
        + processScheduledReminders(date: LocalDate): void
        + postComment(invoiceNumber: String, author: User, text: String): Comment
        + lockFinancialPeriod(periodId: String, lock: boolean): boolean
        + overridePeriodForInvoice(invoiceNumber: String, reason: String): boolean
        + generateAccountingExport(period: FinancialPeriod): AccountingExportPackage
        + reviewAnnualPricing(period: Year): List<PriceReview>
    }

    class ReconciliationController <<control>> {
        - bankingGateway: BankingPaymentGateway
        - auditService: AuditTrailService
        + runAutomatedReconciliation(): void
        + resolveUnmatchedTransaction(txId: String, invoiceNumber: String): boolean
        + allocatePayment(tx: BankTransaction, invoice: Invoice, amount: BigDecimal): PaymentAllocation
    }

    class AccessAndSecurityController <<control>> {
        - auditService: AuditTrailService
        + authenticate(email: String, password: String): boolean
        + delegateAccountAccess(granter: User, grantee: User, customer: Customer, validUntil: LocalDate): AccountDelegation
        + assignSubstituteApprover(primary: User, substitute: User, scope: String, validUntil: LocalDate): SubstituteApproverAssignment
        + configureRole(roleName: String, permissions: Set<String>): AccessRole
        + assignRoleToUser(user: User, role: AccessRole): void
        + revokeDelegations(): void
    }

    class AuditTrailService <<service>> {
        + logOperation(actor: User, action: String, targetEntity: String, details: String): void
    }
}

' ==========================================================
' 3) DOMAIN LAYER (ENTITIES, VALUE OBJECTS & PORTS)
' ==========================================================
package "com.invoicingsystem.domain" {

    ' --- Enums ---
    enum CustomerStatus {
        PENDING_VERIFICATION
        ACTIVE
        SUSPENDED
        CANCELLED
    }
    enum AccountStanding {
        UP_TO_DATE
        OVERDUE
        SUSPENDED
        IN_DISPUTE
    }
    enum InvoiceStatus {
        DRAFT
        READY
        ISSUED
        SENT
        OVERDUE
        PAID
        PARTIALLY_RECONCILED
    }
    enum InvoiceType {
        RECURRING
        ONE_OFF
        TEST
    }
    enum ApprovalStatus {
        PENDING
        APPROVED
        REJECTED
    }
    enum DelegationStatus {
        ACTIVE
        EXPIRED
        REVOKED
    }
    enum ContactState {
        ACTIVE
        INACTIVE
        ANONYMIZED
    }

    ' --- Identity & Access Control (RBAC sin jerarquía espuria) ---
    class User {
        - userId: String
        - email: String
        - active: boolean
        - preferences: UserPreferences
        + hasPermission(permission: String): boolean
        + hasRole(roleName: String): boolean
        + isAccountNonLocked(): boolean
    }

    class AccessRole {
        - roleId: String
        - name: String
        - permissions: Set<String>
        + grantPermission(permission: String): void
        + revokePermission(permission: String): void
    }

    class AccountDelegation {
        - delegationId: String
        - startDate: LocalDate
        - validUntil: LocalDate
        - status: DelegationStatus
        + isActive(onDate: LocalDate): boolean
        + revoke(): void
    }

    class SubstituteApproverAssignment {
        - assignmentId: String
        - approvalScope: String
        - validUntil: LocalDate
        - status: DelegationStatus
        + isActive(onDate: LocalDate): boolean
        + revoke(): void
    }

    class UserPreferences <<value object>> {
        - language: String
        - fontScale: double
        - highContrast: boolean
        - favoriteEntityIds: List<String>
    }

    ' --- CRM & Subscriptions ---
    class Customer {
        - customerId: String
        - legalName: String
        - commercialName: String
        - taxId: String
        - companyEmail: String
        - status: CustomerStatus
        - standing: AccountStanding
        - tags: List<String>
        + hasCompleteTaxInfo(): boolean
        + getOutstandingBalance(): BigDecimal
        + updateStanding(standing: AccountStanding): void
    }

    class Contact {
        - contactId: String
        - name: String
        - email: String
        - isBillingContact: boolean
        - state: ContactState
        + anonymize(): void
    }

    class BillingPlan {
        - planId: String
        - name: String
        - basePrice: BigDecimal
        - minPrice: BigDecimal
        - maxPrice: BigDecimal
    }

    class Subscription {
        - subscriptionId: String
        - startDate: LocalDate
        - billingAnchorDay: int
        - price: BigDecimal
        - active: boolean
        + getPriceOn(date: LocalDate): BigDecimal
        + applyPriceReview(review: PriceReview): void
    }

    class CommercialException {
        - exceptionId: String
        - type: String
        - discountValue: BigDecimal
        - startDate: LocalDate
        - endDate: LocalDate
        - status: ApprovalStatus
        + approve(reviewer: User): void
        + reject(reviewer: User): void
    }

    class CancellationRequest {
        - requestId: String
        - requestDate: LocalDate
        - reason: String
        - status: ApprovalStatus
        + approve(reviewer: User): void
        + reject(reviewer: User): void
    }

    ' --- Invoicing & Finance ---
    class Invoice {
        - invoiceNumber: String
        - type: InvoiceType
        - status: InvoiceStatus
        - issueDate: LocalDate
        - dueDate: LocalDate
        - subtotal: BigDecimal
        - vatAmount: BigDecimal
        - total: BigDecimal
        + calculateTotals(): void
        + changeStatus(newStatus: InvoiceStatus): boolean
        + getOutstandingBalance(): BigDecimal
        + isEditable(): boolean
    }

    class InvoiceLine {
        - description: String
        - quantity: int
        - unitPrice: BigDecimal
        - taxRate: BigDecimal
        + getLineTotal(): BigDecimal
    }

    class Comment {
        - commentId: String
        - text: String
        - createdAt: LocalDateTime
    }

    class FinancialPeriod {
        - periodId: String
        - startDate: LocalDate
        - endDate: LocalDate
        - locked: boolean
        + lock(): void
        + unlock(): void
        + isLocked(): boolean
    }

    class AccountingExportPackage {
        - exportId: String
        - version: int
        - generatedAt: LocalDateTime
        - filePath: String
        + isRegenerated(): boolean
    }

    class PriceReview {
        - reviewId: String
        - proposedPrice: BigDecimal
        - approvedPrice: BigDecimal
        - effectiveFrom: LocalDate
        - status: ApprovalStatus
        + approve(reviewer: User, finalPrice: BigDecimal): void
    }

    ' --- Banking & Reconciliation ---
    class BankTransaction {
        - txId: String
        - reference: String
        - amount: BigDecimal
        - valueDate: LocalDate
        - reconciled: boolean
    }

    class PaymentAllocation {
        - allocationId: String
        - amount: BigDecimal
        - allocationDate: LocalDate
    }

    ' --- Notifications & Auditing ---
    class Notification {
        - notificationId: String
        - recipientEmail: String
        - scheduledDate: LocalDate
        - sentAt: LocalDateTime
        - status: String
    }

    class ChangeHistoryRecord {
        - recordId: String
        - entityName: String
        - entityId: String
        - action: String
        - timestamp: LocalDateTime
    }

    ' --- Domain Interfaces (Outbound Ports) ---
    interface BankingPaymentGateway <<interface>> {
        + fetchTransactionsSince(checkpoint: LocalDateTime): List<BankTransaction>
    }

    interface NotificationGateway <<interface>> {
        + sendNotification(email: String, subject: String, body: String): boolean
    }

    interface BusinessCalendarService <<interface>> {
        + isWorkingDay(date: LocalDate, country: String): boolean
        + getNextWorkingDay(date: LocalDate, country: String): LocalDate
    }

    interface FileStorageGateway <<interface>> {
        + storeFile(name: String, content: byte[]): String
        + getFile(storageKey: String): byte[]
    }
}

' ==========================================================
' 4) INFRASTRUCTURE LAYER (ADAPTERS)
' ==========================================================
package "com.invoicingsystem.infrastructure" {
    class BankingApiAdapter {
        + fetchTransactionsSince(checkpoint: LocalDateTime): List<BankTransaction>
    }

    class SmtpNotificationAdapter {
        + sendNotification(email: String, subject: String, body: String): boolean
    }

    class RegionalCalendarAdapter {
        + isWorkingDay(date: LocalDate, country: String): boolean
        + getNextWorkingDay(date: LocalDate, country: String): LocalDate
    }

    class SecureCloudFileStorageAdapter {
        + storeFile(name: String, content: byte[]): String
        + getFile(storageKey: String): byte[]
    }
}

' ==========================================================
' 5) RELATIONSHIPS
' ==========================================================

' Boundaries -> Controls
PortalDashboardView ..> AccessAndSecurityController
CustomerManagementView ..> CustomerSubscriptionController
InvoicingAndReconciliationView ..> InvoicingAndBillingController
InvoicingAndReconciliationView ..> ReconciliationController
SystemAdministrationView ..> AccessAndSecurityController
SystemAdministrationView ..> InvoicingAndBillingController

' Controls -> Domain Entities & Services
CustomerSubscriptionController ..> Customer
CustomerSubscriptionController ..> Subscription
CustomerSubscriptionController ..> NotificationGateway
CustomerSubscriptionController ..> AuditTrailService

InvoicingAndBillingController ..> Invoice
InvoicingAndBillingController ..> FinancialPeriod
InvoicingAndBillingController ..> NotificationGateway
InvoicingAndBillingController ..> BusinessCalendarService
InvoicingAndBillingController ..> AuditTrailService

ReconciliationController ..> BankTransaction
ReconciliationController ..> Invoice
ReconciliationController ..> BankingPaymentGateway

AccessAndSecurityController ..> User
AccessAndSecurityController ..> AccessRole
AccessAndSecurityController ..> AccountDelegation
AccessAndSecurityController ..> SubstituteApproverAssignment

' Domain Relationships: Identity & Access (RBAC)
User "0..*" o-- "1..*" AccessRole : hasRoles
User "1" *-- "0..1" UserPreferences : preferences
User "1" <-- "0..*" AccountDelegation : originalAssignee
User "1" <-- "0..*" AccountDelegation : delegatedTo
User "1" <-- "0..*" SubstituteApproverAssignment : primaryApprover
User "1" <-- "0..*" SubstituteApproverAssignment : substituteApprover

' Domain Relationships: CRM & Subscriptions
Customer "1" *-- "1..*" Contact : contacts
Customer "1" *-- "0..*" Subscription : subscriptions
Subscription "0..*" --> "1" BillingPlan : plan
Subscription "1" *-- "0..*" CommercialException : exceptions
Subscription "1" *-- "0..*" PriceReview : reviews
Customer "1" *-- "0..*" CancellationRequest : cancellations

' Domain Relationships: Invoicing & Financial Period
Customer "1" --> "0..*" Invoice : invoices
Invoice "1" *-- "1..*" InvoiceLine : lines
Invoice "1" *-- "0..*" Comment : comments
Invoice "0..*" --> "1" FinancialPeriod : period
Comment "0..*" --> "1" User : author
Comment "0..*" --> "0..*" User : mentions

' Domain Relationships: Reconciliation
BankTransaction "1" -- "0..*" PaymentAllocation : allocations
Invoice "1" -- "0..*" PaymentAllocation : payments

' Domain Relationships: Notifications & Exports
Invoice "0..1" <-- "0..*" Notification : relatedInvoice
AccountingExportPackage "0..*" --> "1" FinancialPeriod : period
AccountingExportPackage "0..*" --> "1" User : requestedBy
ChangeHistoryRecord "0..*" --> "1" User : performedBy

' Realization of Ports by Adapters
BankingPaymentGateway <|.. BankingApiAdapter
NotificationGateway <|.. SmtpNotificationAdapter
BusinessCalendarService <|.. RegionalCalendarAdapter
FileStorageGateway <|.. SecureCloudFileStorageAdapter

@enduml
