@startuml
scale max 4096x4096
hide circle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 38
skinparam ranksep 40

' --- Styling ---
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
    ArrowColor #2B3E6A
}

skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    FontColor #1E293B
}

' ==========================================================
' 1) PRESENTATION LAYER
' ==========================================================
package "com.invoicingsystem.presentation" {
    class CustomerManagementView {
        + handleCustomerRegistration(name: String, taxId: String, email: String): void
        + handleSubscriptionSetup(customerId: String, planId: String): void
    }

    class InvoicingView {
        + handleInvoiceIssuance(invoiceNumber: String): void
        + handlePeriodLock(periodId: String): void
    }

    class ReconciliationView {
        + handleManualReconciliation(txId: String, invoiceNumber: String): void
    }

    class PortalDashboardView {
        + handleLogin(email: String): void
        + displayDashboard(): void
    }
}

' ==========================================================
' 2) APPLICATION LAYER (SINGLE-RESPONSIBILITY CONTROLLERS)
' ==========================================================
package "com.invoicingsystem.application" {
    class CustomerController {
        - notificationGateway: NotificationGateway
        + registerCustomer(legalName: String, taxId: String, email: String): Customer
        + manageContact(customerId: String, contact: Contact): boolean
        + cancelCustomerAccount(customerId: String, reason: String): boolean
    }

    class SubscriptionController {
        + createSubscription(customerId: String, plan: BillingPlan, startDate: LocalDate): Subscription
        + cancelSubscription(subscriptionId: String): void
    }

    class InvoicingController {
        - calendarService: BusinessCalendarService
        - notificationGateway: NotificationGateway
        + executeRecurringBillingBatch(executionDate: LocalDate): void
        + createAdHocInvoice(customerId: String, lines: List<InvoiceLine>): Invoice
        + issueAndSendInvoice(invoiceNumber: String): Invoice
        + processScheduledReminders(date: LocalDate): void
    }

    class FinancialPeriodController {
        + lockPeriod(periodId: String): boolean
        + overridePeriodLock(periodId: String, invoiceNumber: String, actor: User): boolean
    }

    class ReconciliationController {
        - bankingGateway: BankingPaymentGateway
        + runAutomatedReconciliation(): void
        + resolveUnmatchedTransaction(txId: String, invoiceNumber: String): PaymentAllocation
    }

    class AccessController {
        + authenticate(email: String, password: String): boolean
        + assignRole(user: User, role: AccessRole): void
    }
}

' ==========================================================
' 3) DOMAIN LAYER (CORE ENTITIES, ENUMS & PORTS)
' ==========================================================
package "com.invoicingsystem.domain" {

    ' --- Enums ---
    enum CustomerStatus <<enum>> {
        PENDING_VERIFICATION
        ACTIVE
        SUSPENDED
        CANCELLED
    }

    enum AccountStanding <<enum>> {
        UP_TO_DATE
        OVERDUE
        SUSPENDED
        IN_DISPUTE
    }

    enum InvoiceStatus <<enum>> {
        DRAFT
        READY
        ISSUED
        SENT
        OVERDUE
        PARTIALLY_RECONCILED
        PAID
    }

    enum InvoiceType <<enum>> {
        RECURRING
        ONE_OFF
        TEST
    }

    ' --- Access Control ---
    class User {
        - userId: String
        - email: String
        - active: boolean
        + hasPermission(permission: String): boolean
    }

    class AccessRole {
        - roleId: String
        - name: String
        - permissions: Set<String>
    }

    ' --- CRM & Subscriptions ---
    class Customer {
        - customerId: String
        - legalName: String
        - taxId: String
        - companyEmail: String
        - status: CustomerStatus
        - standing: AccountStanding
        + hasCompleteTaxInfo(): boolean
        + getOutstandingBalance(): float
    }

    class Contact {
        - contactId: String
        - name: String
        - email: String
        - isBillingContact: boolean
        - active: boolean
        + anonymize(): void
    }

    class BillingPlan {
        - planId: String
        - name: String
        - basePrice: float
    }

    class Subscription {
        - subscriptionId: String
        - startDate: LocalDate
        - billingAnchorDay: int
        - paymentTermsDays: int
        - price: float
        - active: boolean
        + activate(): boolean
        + cancel(): void
    }

    ' --- Invoicing & Finance ---
    class Invoice {
        - invoiceNumber: String
        - type: InvoiceType
        - status: InvoiceStatus
        - issueDate: LocalDate
        - dueDate: LocalDate
        - subtotal: float
        - vatAmount: float
        - total: float
        + calculateTotals(): void
        + changeStatus(newStatus: InvoiceStatus): boolean
        + getOutstandingBalance(): float
    }

    class InvoiceLine {
        - description: String
        - quantity: int
        - unitPrice: float
        - taxRate: float
        + getLineTotal(): float
    }

    class FinancialPeriod {
        - periodId: String
        - startDate: LocalDate
        - endDate: LocalDate
        - locked: boolean
        + lock(): void
        + isLocked(): boolean
    }

    ' --- Banking & Reconciliation ---
    class BankTransaction {
        - txId: String
        - reference: String
        - amount: float
        - valueDate: LocalDate
        - reconciled: boolean
        + markReconciled(): void
    }

    class PaymentAllocation {
        - allocationId: String
        - amount: float
        - allocationDate: LocalDate
    }

    ' --- Notifications ---
    class Notification {
        - notificationId: String
        - recipientEmail: String
        - scheduledDate: LocalDate
        - sentAt: LocalDateTime
        - status: String
    }

    ' --- Outbound Ports (Interfaces) ---
    interface BankingPaymentGateway <<interface>> {
        + fetchTransactionsSince(checkpoint: LocalDateTime): List<BankTransaction>
    }

    interface NotificationGateway <<interface>> {
        + sendNotification(email: String, subject: String, body: String): boolean
    }

    interface BusinessCalendarService <<interface>> {
        + isWorkingDay(date: LocalDate, country: String): boolean
        + getNextWorkingDay(date: LocalDate, country: String): LocalDate
    }
}

' ==========================================================
' 4) INFRASTRUCTURE LAYER (ADAPTERS)
' ==========================================================
package "com.invoicingsystem.infrastructure" {
    class BankingApiAdapter {
        + fetchTransactionsSince(checkpoint: LocalDateTime): List<BankTransaction>
    }

    class SmtpNotificationAdapter {
        + sendNotification(email: String, subject: String, body: String): boolean
    }

    class RegionalCalendarAdapter {
        + isWorkingDay(date: LocalDate, country: String): boolean
        + getNextWorkingDay(date: LocalDate, country: String): LocalDate
    }
}

' ==========================================================
' 5) RELATIONSHIPS
' ==========================================================

' Presentation -> Application
PortalDashboardView ..> AccessController
CustomerManagementView ..> CustomerController
CustomerManagementView ..> SubscriptionController
InvoicingView ..> InvoicingController
InvoicingView ..> FinancialPeriodController
ReconciliationView ..> ReconciliationController

' Application -> Domain
AccessController ..> User
AccessController ..> AccessRole

CustomerController ..> Customer
CustomerController ..> NotificationGateway

SubscriptionController ..> Subscription
SubscriptionController ..> BillingPlan

InvoicingController ..> Invoice
InvoicingController ..> BusinessCalendarService
InvoicingController ..> NotificationGateway

FinancialPeriodController ..> FinancialPeriod
FinancialPeriodController ..> User

ReconciliationController ..> BankTransaction
ReconciliationController ..> Invoice
ReconciliationController ..> BankingPaymentGateway

' Domain: Access Control
User "0..*" o-- "1..*" AccessRole : assignedRoles

' Domain: CRM & Subscriptions
Customer "1" *-- "1..*" Contact : contacts
Customer "1" *-- "0..*" Subscription : subscriptions
Subscription "0..*" --> "1" BillingPlan : plan

' Domain: Invoicing & Periods
Customer "1" --> "0..*" Invoice : invoices
Subscription "0..1" --> "0..*" Invoice : generatedInvoices
Invoice "1" *-- "1..*" InvoiceLine : lines
Invoice "0..*" --> "1" FinancialPeriod : period

' Domain: Reconciliation
BankTransaction "1" -- "0..*" PaymentAllocation : allocations
Invoice "1" -- "0..*" PaymentAllocation : payments

' Domain: Notifications
Invoice "0..1" <-- "0..*" Notification : relatedInvoice
User "0..1" <-- "0..*" Notification : recipientUser

' Infrastructure -> Domain Ports
BankingPaymentGateway <|.. BankingApiAdapter
NotificationGateway <|.. SmtpNotificationAdapter
BusinessCalendarService <|.. RegionalCalendarAdapter

' Layout: keep infrastructure below domain (4 stacked layers) and expand domain rightward
Subscription -[hidden]right-> User
InvoiceLine -[hidden]-> RegionalCalendarAdapter
Notification -[hidden]-> SmtpNotificationAdapter
PaymentAllocation -[hidden]-> BankingApiAdapter

@enduml
