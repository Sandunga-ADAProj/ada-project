@startuml
left to right direction

' Global settings
skinparam shadowing false
skinparam packageStyle rectangle

' Use Case styling
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Actor styling
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

'=== Actors ===
' Human Actors
actor "Base User" as User
actor "Administrator" as Admin
actor "Super-Administrator" as SuperAdmin

' System Actors
actor "Banking API" as BankAPI << System >>
actor "Email / SMS Gateway" as NotifSystem << System >>
actor "System Scheduler" as Timer << System >>


'=== System Boundary ===
rectangle "Subscription Management & Invoicing System" {

    '=== Use Cases ===
    ' Authentication & Personalization
    usecase "Log In to Portal" as UC01
    usecase "Configure Personal Preferences" as UC02
    usecase "View Assigned Client Invoices" as UC03
    usecase "Add Contextual Comment & @Mention" as UC04
    usecase "View Financial Dashboard" as UC05
    usecase "Search & Filter Records" as UC06

    ' Customer Onboarding & Management
    usecase "Register Customer Profile" as UC07
    usecase "Verify Company Email" as UC08
    usecase "Check Duplicate Records" as UC09
    usecase UC10 as "Manage Customer Contacts
    --
    **extension points**
    erasure request"
    usecase "Assign Customer Tags" as UC11
    usecase "Attach Supporting Documents" as UC12
    usecase "Anonymize Personal Contact Information" as UC13

    ' Subscription & Pricing Workflows
    usecase UC14 as "Set Up Subscription Plan
    --
    **extension points**
    commercial exception"
    usecase UC15 as "Detect Price Inconsistencies
    --
    **extension points**
    inconsistency found"
    usecase "Review Flagged Prices" as UC16
    usecase "Propose Commercial Exception" as UC17
    usecase "Approve Standard Exception" as UC18
    usecase "Approve High-Threshold Exception" as UC19
    usecase "Configure Standard Pricing Structure" as UC20
    usecase "Activate Pending Subscription" as UC21

    ' Invoicing & Financial Operations
    usecase "Generate Monthly Recurring Invoices" as UC22
    usecase "Generate Ad-Hoc Invoice" as UC23
    usecase "Manage Test Invoices" as UC24
    usecase "Lock Financial Period" as UC25
    usecase "Adjust Dates for Non-Working Days" as UC26
    usecase "Issue Invoice" as UC27
    usecase "Send Invoice" as UC28
    usecase "Update Account Standing" as UC29
    usecase "Override Locked Period" as UC30

    ' Banking Integration & Reconciliation
    usecase "Fetch Bank Transactions" as UC31
    usecase UC32 as "Reconcile Payments
    --
    **extension points**
    ambiguous transaction"
    usecase "Review Unmatched Payment" as UC33

    ' Notifications & Account Cancellation
    usecase "Send Automated Notifications & Reminders" as UC34
    usecase "Configure Notification Triggers" as UC35
    usecase "Process Account Cancellation" as UC36
    usecase "Request Account Cancellation" as UC37
    usecase "Freeze Recurring Billing" as UC38
    usecase "View Outstanding Obligations" as UC39

    note right of UC36
        Overdue notifications for historical invoices
        must persist even after cancellation
    end note

    ' System Administration & Security
    usecase "Delegate Account Permissions" as UC40
    usecase "Define Roles & System Permissions" as UC41
    usecase "Modify Workflows & System Rules" as UC42
    usecase "Record Audit Entry" as UC43
    usecase "Preserve Historical Invoice Records" as UC44

}

'=== Relationships ===
' Actor Generalizations
Admin --|> User
SuperAdmin --|> Admin

' Base User Associations (UC01-UC06, UC17, UC37)
User -- UC01
User -- UC02
User -- UC03
User -- UC04
User -- UC05
User -- UC06
User -- UC17
User -- UC37

' Administrator Associations (UC07, UC10-UC14, UC16, UC18, UC23-UC25, UC27-UC28, UC33, UC35-UC36, UC40)
Admin -- UC07
Admin -- UC10
Admin -- UC11
Admin -- UC12
Admin -- UC13
Admin -- UC14
Admin -- UC16
Admin -- UC18
Admin -- UC23
Admin -- UC24
Admin -- UC25
Admin -- UC27
Admin -- UC28
Admin -- UC33
Admin -- UC35
Admin -- UC36
Admin -- UC40

' Super-Administrator Associations (UC19-UC20, UC30, UC41-UC42)
SuperAdmin -- UC19
SuperAdmin -- UC20
SuperAdmin -- UC30
SuperAdmin -- UC41
SuperAdmin -- UC42

' Automated System Actor Associations
Timer -- UC15
Timer -- UC21
Timer -- UC22
Timer -- UC29
Timer -- UC32
Timer -- UC34
UC31 -- BankAPI
UC34 -- NotifSystem

' Include Relationships
UC07 ..> UC08 : <<include>>
UC07 ..> UC09 : <<include>>
UC22 ..> UC26 : <<include>>
UC34 ..> UC26 : <<include>>
UC32 ..> UC31 : <<include>>
UC32 ..> UC29 : <<include>>
UC28 ..> UC34 : <<include>>
UC24 ..> UC43 : <<include>>
UC20 ..> UC43 : <<include>>
UC18 ..> UC43 : <<include>>
UC19 ..> UC43 : <<include>>
UC30 ..> UC43 : <<include>>
UC37 ..> UC34 : <<include>>
UC36 ..> UC38 : <<include>>
UC36 ..> UC39 : <<include>>
UC36 ..> UC44 : <<include>>
UC13 ..> UC44 : <<include>>
UC13 ..> UC43 : <<include>>

' Extend Relationships
UC14 <.. UC17 : <<extend>>\n(commercial exception)
UC32 <.. UC33 : <<extend>>\n(ambiguous transaction)
UC15 <.. UC16 : <<extend>>\n(inconsistency found)
UC23 <.. UC30 : <<extend>>\n(period locked)
UC24 <.. UC30 : <<extend>>\n(period locked)
UC10 <.. UC13 : <<extend>>\n(erasure request)

@enduml