@startuml
skinparam boxPadding 10

' Component/Participant styling
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

title Sequence Diagram - Automated Recurring Billing Batch & Calendar Adjustment (UC-13, UC-19, FR-2.1.1, FR-2.1.2, FR-2.2.1, FR-2.2.2, FR-4.4.2)

actor Scheduler as "billingScheduler : SystemDaemon"

box "Application Layer" #EBF0F5
    participant Ctrl as "invoicingCtrl : InvoicingAndBillingController" <<control>>
end box

box "Domain Layer" #FFFFFF
    participant Calendar as "calendarService : BusinessCalendarService" <<interface>>
    participant Customer as "targetCustomer : Customer"
    participant Sub as "subscription : Subscription"
    participant Invoice as "newInvoice : Invoice"
    participant Line as "lineItem : InvoiceLine"
end box

box "Infrastructure Layer" #F5F7FA
    participant CalAdapter as "calendarAdapter : RegionalCalendarAdapter" <<infrastructure>>
end box

' --- SEQUENCE FLOW ---

autonumber "<b>[00]</b>"


== Step 1: Automated Recurring Billing (UC-13, FR-2.1.1, FR-2.1.2) ==

Scheduler -> Ctrl : executeRecurringBillingBatch(executionDate)
activate Ctrl

loop For each subscription scheduled for this billing anchor

    Ctrl -> Ctrl : checkBillingEligibility(subscription, customer, executionDate)

    alt Subscription inactive, activation date not reached, or customer cancelled
        Ctrl -> Ctrl : recordSkippedSubscription(subscription)

    else Subscription eligible

        Ctrl -> Customer : hasCompleteTaxInfo()
        activate Customer
        Customer --> Ctrl : isValidTaxInfo
        deactivate Customer

        alt Missing tax information

            ref over Ctrl, Customer : DS-BASE: Alert Administrator of Missing Tax Information (FR-4.2.2)

            Ctrl -> Ctrl : recordSkippedSubscription(subscription)

        else Tax information complete

            Ctrl -> Ctrl : invoiceAlreadyExists(subscription, executionDate)

            alt Invoice already generated for this billing period
                Ctrl -> Ctrl : recordSkippedSubscription(subscription)

            else No duplicate invoice

                Ctrl -> Ctrl : isFinancialPeriodLocked(executionDate)

                alt Financial period locked
                    Ctrl -> Ctrl : recordBlockedGeneration(subscription)

                    ref over Ctrl, Customer : DS-BASE: Audit Blocked Invoice Creation (FR-2.7)

                else Financial period open

                    == Step 2: Due Date & Calendar Adjustment (UC-19, FR-4.4.2) ==

                    Ctrl -> Ctrl : dueDate = executionDate.plusDays(subscription.paymentTermsDays)

                    Ctrl -> Calendar : isWorkingDay(dueDate, customer.country)
                    activate Calendar

                    Calendar -> CalAdapter : isWorkingDay(dueDate, customer.country)
                    activate CalAdapter
                    CalAdapter --> Calendar : isWorking
                    deactivate CalAdapter

                    Calendar --> Ctrl : isWorking
                    deactivate Calendar

                    opt Due date is not a working day
                        Ctrl -> Calendar : getNextWorkingDay(dueDate, customer.country)
                        activate Calendar

                        Calendar -> CalAdapter : getNextWorkingDay(dueDate, customer.country)
                        activate CalAdapter
                        CalAdapter --> Calendar : adjustedDueDate
                        deactivate CalAdapter

                        Calendar --> Ctrl : adjustedDueDate
                        deactivate Calendar

                        Ctrl -> Ctrl : dueDate = adjustedDueDate
                    end

                    == Step 3: Invoice Generation & Tax Calculation (FR-2.2.1, FR-2.2.2) ==

                    Ctrl -> Ctrl : invoiceNumber = nextSequentialInvoiceNumber()
                    Ctrl -> Ctrl : taxRate = resolveApplicableTaxRate(customer, subscription)

                    create Invoice
                    Ctrl -> Invoice : <<create>> (invoiceNumber, type=RECURRING, status=READY, issueDate=null, dueDate)
                    activate Invoice
                    Invoice --> Ctrl : newInvoice
                    deactivate Invoice

                    Ctrl -> Invoice : populateBillingDetails(customer)
                    activate Invoice
                    Invoice --> Ctrl : completed
                    deactivate Invoice

                    create Line
                    Ctrl -> Line : <<create>> (desc="Subscription Fee", qty=1, unitPrice=sub.price, taxRate=taxRate)
                    activate Line
                    Line --> Ctrl : lineItem
                    deactivate Line

                    Ctrl -> Invoice : addInvoiceLine(lineItem)
                    activate Invoice

                    Invoice -> Invoice : calculateVatAndTotals()

                    Invoice --> Ctrl : totalsCalculated
                    deactivate Invoice

                    Ctrl -> Customer : linkInvoice(newInvoice)
                    activate Customer
                    Customer --> Ctrl : true
                    deactivate Customer

                    note over Invoice
                        Invoice remains READY.
                        Issue date is assigned when issued.
                        Due date is recalculated if necessary.
                    end note

                    ref over Ctrl, Invoice : DS-BASE: Invoice Creation Audit Trail

                end
            end
        end
    end
end

Ctrl --> Scheduler : completed
deactivate Ctrl
@enduml