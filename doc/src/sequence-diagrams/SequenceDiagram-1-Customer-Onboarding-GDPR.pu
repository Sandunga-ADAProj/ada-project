@startuml
skinparam boxPadding 10
skinparam participantPadding 10
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}
skinparam arrow {
    Color #2B3E6A
}
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

title Sequence Diagram 1 - Customer Onboarding, Email Verification & GDPR (FR-1.1, FR-1.2, FR-1.3, FR-1.4, FR-5.5)

actor "adminUser : Admin" as Admin
actor "companyRepresentative : Company Representative" as CompanyRep

box "Presentation Layer" #F5F7FA
    participant "customerView : CustomerManagementView" as View <<boundary>>
end box
box "Application Layer" #EBF0F5
    participant "customerCtrl : CustomerAndSubscriptionController" as Ctrl <<control>>
end box
box "Domain Layer" #FFFFFF
    participant "newCustomer : Customer" as Customer
    participant "billingContact : Contact" as BillingContact
    participant "targetContact : Contact" as TargetContact
    participant "notifier : NotificationGateway" as Notifier <<interface>>
end box

autonumber "<b>[00]</b>"

== Step 1: Complete Customer Registration (FR-1.2, FR-1.4) ==

Admin -> View : onRegisterCustomerClicked(registrationData)
activate View
View -> Ctrl : registerCustomer(adminUser, registrationData)
activate Ctrl

note over View, Ctrl
    registrationData includes commercial/trading/legal names,
    Tax ID, tax address, country, currency, company email,
    and the primary contact's name, email and phone.
end note

Ctrl -> Ctrl : detectPotentialDuplicates(data.taxId, data.legalName)
alt Potential duplicate found
    Ctrl --> View : matchingRecords / duplicateWarning
    View --> Admin : Request manual review before saving
else No duplicate found
    create Customer
    Ctrl -> Customer : <<create>> (data.commercialName, data.tradingName, data.legalName, data.taxId, data.taxAddress, data.country, data.currency, data.companyEmail, PENDING_VERIFICATION)
    activate Customer
    Customer --> Ctrl : newCustomer
    deactivate Customer

    create BillingContact
    Ctrl -> BillingContact : <<create>> (name=data.primaryContactName, email=data.primaryContactEmail, phone=data.primaryContactPhone, isBillingContact=true, state=ACTIVE)
    activate BillingContact
    BillingContact --> Ctrl : billingContact
    deactivate BillingContact

    Ctrl -> Customer : addContact(billingContact)
    activate Customer
    Customer --> Ctrl : billingContact
    deactivate Customer

    Ctrl -> Ctrl : generateVerificationToken(newCustomer)
    Ctrl --> Ctrl : token
    Ctrl -> Ctrl : buildVerificationLink(token)
    Ctrl --> Ctrl : verificationLink

    Ctrl -> Notifier : sendNotification(data.companyEmail, "Verify company email", verificationLink)
    activate Notifier
    Notifier --> Ctrl : sent
    deactivate Notifier

    alt Verification email accepted for sending
        Ctrl --> View : customer in PENDING_VERIFICATION
        View --> Admin : Display pending verification status
    else Email delivery failed
        Ctrl --> View : customer saved; email delivery failed
        View --> Admin : Display retry warning
    end
end

deactivate Ctrl
deactivate View

== Step 1B: Company Email Verification (FR-1.1) ==
opt Customer exists and verification link was delivered
    CompanyRep -> View : onVerifyCompanyEmailClicked(customerId, token)
    activate View
    View -> Ctrl : verifyCompanyEmail(customerId, token)
    activate Ctrl
    Ctrl -> Ctrl : validateVerificationToken(customerId, token)
    alt Token belongs to customer, valid and unused
        Ctrl -> Customer : markEmailVerified()
        activate Customer
        Customer --> Ctrl : success
        deactivate Customer
        Ctrl --> View : verificationSuccessful
        View --> CompanyRep : Display confirmation
    else Token invalid, reused or expired
        Ctrl --> View : verificationFailed
        View --> CompanyRep : Display error
    end
    deactivate Ctrl
    deactivate View
end

== Step 2: Contact Management & GDPR Anonymization (FR-1.3, FR-5.5) ==
Admin -> View : onAnonymizeContactClicked(customerId, targetContactId)
activate View
View -> Ctrl : anonymizeContactData(adminUser, targetContact)
activate Ctrl
Ctrl -> Ctrl : checkAnonymizationAllowed(customer, targetContact)
alt Target is the only active billing contact
    Ctrl --> View : Anonymization rejected
    View --> Admin : Cannot remove sole billing contact
else Anonymization is legally prohibited
    Ctrl --> View : Anonymization rejected
    View --> Admin : Display retention restriction
else Anonymization permitted
    Ctrl -> Customer : deactivateContact(targetContact)
    activate Customer
    Customer --> Ctrl : true
    deactivate Customer
    Ctrl -> TargetContact : anonymize()
    activate TargetContact
    note over TargetContact
        Remove personal identifiers when legally permitted;
        keep contactId and mandatory accounting history.
    end note
    TargetContact --> Ctrl : completed
    deactivate TargetContact
    ref over Ctrl, Customer : DS-BASE: Notification Dispatch & Audit Trail
    Ctrl --> View : updatedContacts
    View -> View : renderContactsList(updatedContacts)
    View --> Admin : Display anonymized contact
end

deactivate Ctrl
deactivate View
@enduml
