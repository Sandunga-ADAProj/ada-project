@startuml
skinparam boxPadding 10

' Component/Participant styling
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

title Sequence Diagram - Subscription Setup & Commercial Exception Approval (UC-08, UC-09, UC-10, UC-12, FR-2.1.2, FR-2.6.2, FR-2.6.3)

actor Staff as "staffUser : User"
actor Admin as "approverAdmin : Admin"

box "Presentation Layer" #F5F7FA
    participant View as "customerView : CustomerManagementView" <<boundary>>
end box

box "Application Layer" #EBF0F5
    participant Ctrl as "customerCtrl : CustomerAndSubscriptionController" <<control>>
end box

box "Domain Layer" #FFFFFF
    participant Customer as "targetCustomer : Customer"
    participant Plan as "standardPlan : BillingPlan"
    participant Sub as "subscription : Subscription"
    participant Exception as "commercialException : CommercialException"
    participant Review as "priceReview : PriceReview"
end box

' --- SEQUENCE FLOW ---

autonumber "<b>[00]</b>"

== Step 1: Subscription Setup with Deferred Activation (UC-08, FR-2.1.2) ==

Admin -> View : onSetupSubscriptionClicked(customerId, planId, futureStartDate)
activate View

View -> Ctrl : configureSubscription(admin, targetCustomer, standardPlan, futureStartDate)
activate Ctrl

create Sub
Ctrl -> Sub : <<create>> (plan=standardPlan, startDate=futureStartDate, anchorDay=dayOfMonth(futureStartDate), status=PENDING_ACTIVATION)
activate Sub
Sub --> Ctrl : return subscription
deactivate Sub

Ctrl -> Customer : addSubscription(subscription)
activate Customer
Customer --> Ctrl : true
deactivate Customer

opt Customer has no other active subscriptions
    Ctrl -> Customer : setStatus(PENDING_ACTIVATION)
    activate Customer
    Customer --> Ctrl : completed
    deactivate Customer
end

Ctrl --> View : subscription
deactivate Ctrl

View -> View : renderSubscriptionSetup(subscription)
View --> Admin : Displays subscription in PENDING_ACTIVATION state
deactivate View


== Step 2: Propose Commercial Exception & Price Review (UC-09, UC-12, FR-2.6.1, FR-2.6.2) ==

Staff -> View : onProposeExceptionClicked(subId, "VOLUME_DISCOUNT", 0.25)
activate View

View -> Ctrl : submitCommercialException(staffUser, subscription, "VOLUME_DISCOUNT", 0.25)
activate Ctrl

create Exception
Ctrl -> Exception : <<create>> (type="VOLUME_DISCOUNT", value=0.25, status=PENDING)
activate Exception
Exception --> Ctrl : commercialException
deactivate Exception

Ctrl -> Ctrl : proposedPrice = calculateDiscountedPrice(subscription, 0.25)

opt Proposed price outside configured plan range
    create Review
    Ctrl -> Review : <<create>> (proposedPrice, reason="Price outside allowed range", status=PENDING)
    activate Review
    Review --> Ctrl : priceReview
    deactivate Review
end

Ctrl --> View : commercialException
deactivate Ctrl

View -> View : renderExceptionSubmitted(commercialException)
View --> Staff : Displays submission confirmation (PENDING)

deactivate View


== Step 3: Administrator Decision Workflow (UC-10, FR-2.6.3, FR-2.6.4) ==

Admin -> View : onProcessExceptionClicked(exceptionId, approved)
activate View

View -> Ctrl : approveCommercialException(approverAdmin, commercialException, approved)
activate Ctrl

Ctrl -> Ctrl : hasRequiredApprovalAuthority(approverAdmin, commercialException)

alt Insufficient approval authority

    Ctrl --> View : Authorization denied
    View --> Admin : Higher approval level required

else Authorized and approved

    Ctrl -> Exception : approve()
    activate Exception
    Exception --> Ctrl : status=APPROVED
    deactivate Exception

    Ctrl -> Ctrl : discountedPrice = calculateDiscountedPrice(subscription, 0.25)

    Ctrl -> Sub : setPrice(discountedPrice)
    activate Sub
    Sub --> Ctrl : true
    deactivate Sub

    opt Associated PriceReview exists
        Ctrl -> Review : setStatus(APPROVED)
        Review --> Ctrl : completed
    end

    ref over Ctrl, Sub : DS-BASE: Notification & Pricing Audit (oldPrice, newPrice, approver, timestamp)

    Ctrl --> View : true
    View --> Admin : Displays approved discount

else Authorized and rejected

    Ctrl -> Exception : reject()
    activate Exception
    Exception --> Ctrl : status=REJECTED
    deactivate Exception

    opt Associated PriceReview exists
        Ctrl -> Review : setStatus(REJECTED)
        Review --> Ctrl : completed
    end

    ref over Ctrl, Exception : DS-BASE: Notification & Audit Trail

    Ctrl --> View : false
    View --> Admin : Displays rejection confirmation

end
deactivate Ctrl
deactivate View

@enduml

