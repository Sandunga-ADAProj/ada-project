@startuml
skinparam boxPadding 10

' Component/Participant styling
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

title Sequence Diagram - Account Cancellation Request & Billing Freeze Workflow (UC-25, UC-26, FR-5.1, FR-5.2, FR-5.3, FR-5.4)

actor Staff as "staffUser : User"
actor Admin as "adminUser : Admin"

box "Presentation Layer" #F5F7FA
    ' CustomerManagementView — ComponentsDiagram (<<boundary>>, CustomerSubscriptionAPI)
    participant View as "custView : CustomerManagementView" <<boundary>>
end box

box "Application Layer" #EBF0F5
    ' CustomerAndSubscriptionController — uses CustomerAPI (ComponentsDiagram)
    participant Ctrl as "custCtrl : CustomerAndSubscriptionController" <<control>>
end box

box "Domain Layer" #FFFFFF
    ' Customer & Subscription subdomain (via CustomerAPI)
    participant Customer as "targetCustomer : Customer"
    participant Sub as "activeSub : Subscription"
    participant Req as "cancelRequest : CancellationRequest"
    ' Note: Invoice entity belongs to "Invoice Management" subdomain (InvoiceAPI).
    ' CustomerAndSubscriptionController has no InvoiceAPI dependency; Invoice is NOT
    ' messaged directly here — outstanding balance is surfaced through Customer.getOutstandingBalance().
end box

' --- SEQUENCE FLOW ---

autonumber "<b>[00]</b>"


== Step 1: Cancellation Request Submission (UC-25, FR-5.3) ==

Staff -> View : onRequestCancellationClicked(customerId, reason)
activate View

View -> Ctrl : handleCancellationWorkflow(staffUser, targetCustomer, reason)
activate Ctrl

Ctrl -> Ctrl : validateCancellationRequest(staffUser, targetCustomer)

alt Request invalid or user not authorized

    Ctrl --> View : Request rejected
    View --> Staff : Display validation error

else Request permitted

    Ctrl -> Customer : getOutstandingBalance()
    activate Customer
    Customer --> Ctrl : outstandingBalance
    deactivate Customer

    create Req
    Ctrl -> Req : <<create>> (requestDate=today, reason, outstandingBalance, status=PENDING)
    activate Req
    Req --> Ctrl : cancelRequest
    deactivate Req

    ref over Ctrl, Req : DS-BASE: Notify Administrator & Audit Cancellation Request (FR-5.3.1)

    Ctrl --> View : cancelRequest
    View -> View : renderCancellationSubmitted(cancelRequest)
    View --> Staff : Display cancellation request as PENDING

end

deactivate Ctrl
deactivate View


== Step 2: Administrator Review & Decision (UC-26, FR-5.3) ==

opt Valid pending cancellation request exists

    Admin -> View : onReviewCancellationClicked(requestId)
    activate View

    View -> Ctrl : getCancellationReview(adminUser, cancelRequest)
    activate Ctrl

    Ctrl -> Customer : getOutstandingBalance()
    activate Customer
    Customer --> Ctrl : outstandingBalance
    deactivate Customer

    Ctrl -> Ctrl : prepareMinimumAuthorizedAccountDetails(targetCustomer)

    Ctrl --> View : cancellationReviewSummary
    deactivate Ctrl

    View -> View : renderCancellationReview(cancellationReviewSummary)
    View --> Admin : Display request and outstanding obligations

    Admin -> View : onProcessCancellationClicked(requestId, approved)

    View -> Ctrl : processCancellationRequest(adminUser, cancelRequest, approved)
    activate Ctrl

    Ctrl -> Ctrl : validateCancellationDecision(adminUser, cancelRequest)

    alt Administrator unauthorized or request not PENDING

        Ctrl --> View : Decision rejected
        View --> Admin : Display validation error

    else Authorized and approved

        Ctrl -> Req : approve()
        activate Req
        Req --> Ctrl : status=APPROVED
        deactivate Req

        == Step 3: Freeze Recurring Billing (FR-5.1) ==

        Ctrl -> Customer : getSubscriptions()
        activate Customer
        Customer --> Ctrl : subscriptions
        deactivate Customer

        loop For each ACTIVE or PENDING_ACTIVATION subscription

            Ctrl -> Sub : setStatus(CANCELLED)
            activate Sub

            note over Sub
                Recurring invoice generation stops.
                Subscription history is preserved.
            end note

            Sub --> Ctrl : completed
            deactivate Sub

        end

        Ctrl -> Customer : setStatus(CANCELLED)
        activate Customer
        Customer --> Ctrl : completed
        deactivate Customer

        == Step 4: Historical Debt & Record Retention (FR-5.2, FR-5.4) ==

        opt Outstanding balance is greater than zero

            note over Customer
                Historical unpaid invoices remain valid.
                Existing overdue notification workflows
                continue until the debt is resolved.
                No historical invoices are deleted.
            end note

        end

        note over Customer
            Company records and accounting history
            are retained according to legal requirements.
        end note

        ref over Ctrl, Customer : DS-BASE: Cancellation Decision Notification & Audit

        Ctrl --> View : Cancellation approved
        View -> View : renderCancellationProcessed(true)
        View --> Admin : Display cancellation confirmation

    else Authorized and rejected

        Ctrl -> Req : reject()
        activate Req
        Req --> Ctrl : status=REJECTED
        deactivate Req

        note over Sub
            Subscription status remains unchanged.
            Recurring billing continues normally.
        end note

        ref over Ctrl, Req : DS-BASE: Cancellation Rejection Notification & Audit

        Ctrl --> View : Cancellation rejected
        View -> View : renderCancellationProcessed(false)
        View --> Admin : Display rejection confirmation

    end

    deactivate Ctrl
    deactivate View

end

@enduml
