@startuml
skinparam boxPadding 10

' Component/Participant styling
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

title Sequence Diagram - Authentication, Account Delegation & Contextual Collaboration (UC-01, UC-02, UC-04, UC-27, UR-1.1, UR-2.2, FR-2.8, FR-6.2, FR-7.3, FR-7.5.3)
actor Staff as "staffUser : User"
actor Admin as "adminUser : Admin"
actor Scheduler as "delegationScheduler : SystemDaemon"

' ─────────────────────────────────────────────────────────────────────────────
' PARTICIPANTS — aligned with ComponentsDiagram.pu
'
'  Presentation Layer:
'    PortalDashboardView      (<<boundary>>) — AccessConfigAPI
'    InvoicingAndReconciliationView (<<boundary>>) — InvoicingBillingAPI
'
'  Application Layer:
'    AccessAndConfigController (<<control>>) — uses UserAPI, BillingPlanAPI,
'                                              NotificationGateway
'    InvoicingAndBillingController (<<control>>) — uses InvoiceAPI,
'                                                  NotificationGateway,
'                                                  BusinessCalendarService
'
'  Domain Layer:
'    User & Access subdomain  → User, AccountDelegation  (via UserAPI)
'    Invoice Management subdomain → Invoice, Comment     (via InvoiceAPI)
' ─────────────────────────────────────────────────────────────────────────────

box "Presentation Layer" #F5F7FA
    participant PView as "portalView : PortalDashboardView" <<boundary>>
    participant IView as "invoicingView : InvoicingAndReconciliationView" <<boundary>>
end box

box "Application Layer" #EBF0F5
    ' AccessAndConfigController — uses UserAPI & NotificationGateway
    participant ACtrl as "accessCtrl : AccessAndConfigController" <<control>>
    ' InvoicingAndBillingController — uses InvoiceAPI & NotificationGateway
    participant ICtrl as "invoicingCtrl : InvoicingAndBillingController" <<control>>
end box

box "Domain Layer" #FFFFFF
    ' ── User & Access subdomain (UserAPI) ────────────────────────────────────
    participant User as "authenticatedUser : User"
    ' AccountDelegation belongs to the User & Access subdomain (UserAPI port)
    participant Delegation as "delegation : AccountDelegation"
    ' ── Invoice Management subdomain (InvoiceAPI) ────────────────────────────
    participant Invoice as "targetInvoice : Invoice"
    participant Comment as "contextComment : Comment"
end box

' --- SEQUENCE FLOW ---

autonumber "<b>[00]</b>"


== Step 1: Authentication & Dashboard Retrieval (UC-01, UC-02, UR-1.1, FR-6.2, FR-7.5.3) ==

Staff -> PView : onLoginClicked(email, password)
activate PView

PView -> ACtrl : authenticateUser(email, password)
activate ACtrl

ACtrl -> ACtrl : checkAccountStatusAndLockout(email)

alt Account temporarily blocked

    ACtrl --> PView : Authentication denied
    PView --> Staff : Display account lockout message

else Account allowed to authenticate

    ACtrl -> ACtrl : verifyPasswordAgainstStoredHash(email, password)

    alt Credentials valid

        ACtrl -> ACtrl : resetFailedLoginAttempts(email)
        ACtrl --> PView : true

        PView -> ACtrl : getDashboardSummary(staffUser)
        ACtrl --> PView : dashboardData

        PView -> PView : renderDashboardSummary(dashboardData)
        PView --> Staff : Display personalized dashboard

    else Credentials invalid

        ACtrl -> ACtrl : recordFailedLoginAttempt(email)

        opt Three consecutive failed login attempts
            ACtrl -> ACtrl : blockAuthentication(email, 5 minutes)
        end

        ACtrl --> PView : false
        PView --> Staff : Display authentication error

    end
end

deactivate ACtrl
deactivate PView


== Step 2: Time-Bound Permission Delegation (UC-27, UR-2.2, FR-7.3.1) ==

Admin -> PView : onDelegateAccessClicked(granteeUser, customerScope, validUntil)
activate PView

PView -> ACtrl : delegateAccountAccess(adminUser, staffUser, granteeUser, customerScope, validUntil)
activate ACtrl

ACtrl -> ACtrl : validateDelegation(adminUser, staffUser, granteeUser, customerScope, validUntil)

alt Administrator unauthorized or delegation invalid

    ACtrl --> PView : Delegation rejected
    PView --> Admin : Display authorization or validation error

else Delegation permitted

    create Delegation
    ACtrl -> Delegation : <<create>> (originalAssignee=staffUser, grantee=granteeUser, scope=customerScope, startDate=today, validUntil, status=ACTIVE)
    activate Delegation
    Delegation --> ACtrl : delegation
    deactivate Delegation

    note over Delegation
        Original account assignment is preserved.
        Delegated access is restricted to the
        authorized scope and validity period.
    end note

    ref over ACtrl, Delegation : DS-BASE: Delegation Audit & Security Notification

    ACtrl --> PView : delegation
    PView -> PView : renderDelegationSuccess(delegation)
    PView --> Admin : Display active delegation

end

deactivate ACtrl
deactivate PView


== Step 2B: Automatic Expiration & Manual Revocation (UR-2.2, FR-7.3.2) ==

Scheduler -> ACtrl : expireDelegations(today)
activate ACtrl

opt Delegation is ACTIVE and today > validUntil

    ACtrl -> Delegation : expire()
    activate Delegation
    Delegation --> ACtrl : status=EXPIRED
    deactivate Delegation

    ref over ACtrl, Delegation : DS-BASE: Delegation Expiration Audit

end

deactivate ACtrl

Admin -> PView : onRevokeDelegationClicked(delegationId)
activate PView

PView -> ACtrl : revokeAccountDelegation(adminUser, delegation)
activate ACtrl

ACtrl -> ACtrl : validateRevocationPermission(adminUser, delegation)

alt Revocation permitted and delegation ACTIVE

    ACtrl -> Delegation : revoke()
    activate Delegation
    Delegation --> ACtrl : status=REVOKED
    deactivate Delegation

    ref over ACtrl, Delegation : DS-BASE: Delegation Revocation Audit

    ACtrl --> PView : true
    PView --> Admin : Display revocation confirmation

else Revocation not permitted

    ACtrl --> PView : false
    PView --> Admin : Display validation error

end

deactivate ACtrl
deactivate PView


== Step 3: Contextual Invoice Collaboration & Mentions (UC-04, FR-2.8) ==

Staff -> IView : onAddCommentClicked(invoiceNumber, text)
activate IView

IView -> ICtrl : postInvoiceComment(staffUser, targetInvoice, text)
activate ICtrl

ICtrl -> ICtrl : checkCommentPermission(staffUser, targetInvoice)

alt User not authorized to access invoice

    ICtrl --> IView : Comment rejected
    IView --> Staff : Display permission error

else User authorized

    ICtrl -> ICtrl : mentionedUsers = resolveMentions(text)

    create Comment
    ICtrl -> Comment : <<create>> (author=staffUser, text=text, createdAt=now(), mentions=mentionedUsers)
    activate Comment
    Comment --> ICtrl : contextComment
    deactivate Comment

    ICtrl -> Invoice : addComment(contextComment)
    activate Invoice
    Invoice --> ICtrl : true
    deactivate Invoice

    opt Comment contains valid user mentions

        ref over ICtrl, Comment : DS-BASE: Targeted Mention Notification (FR-2.8)

    end

    ref over ICtrl, Comment : DS-BASE: Comment Creation Audit

    ICtrl --> IView : updatedComments
    IView -> IView : renderInvoiceDetails(targetInvoice, updatedComments)
    IView --> Staff : Display updated invoice comments

end

deactivate ICtrl
deactivate IView


@enduml
