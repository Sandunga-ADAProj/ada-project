@startuml
skinparam boxPadding 10
skinparam participantPadding 10
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}
skinparam arrow {
    Color #2B3E6A
}
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

title Sequence Diagram 4 - Invoice Lifecycle, Period Lock & Accounting Export (FR-2.3.2, FR-2.4, FR-2.7, FR-4.1.1, FR-6.3, FR-6.4)

actor "adminUser : Admin" as Admin
actor "superAdmin : SuperAdmin" as SuperAdmin

box "Presentation Layer" #F5F7FA
    participant "invoicingView : InvoicingAndReconciliationView" as View <<boundary>>
    participant "administrationView : SystemAdministrationView" as AdminView <<boundary>>
end box
box "Application Layer" #EBF0F5
    participant "invoicingCtrl : InvoicingAndBillingController" as Ctrl <<control>>
end box
box "Domain Layer" #FFFFFF
    participant "targetInvoice : Invoice" as Invoice
    participant "testInvoice : Invoice" as TestInvoice
    participant "fiscalPeriod : FinancialPeriod" as Period
    participant "accountingExport : AccountingExportPackage" as Pkg
    participant "notificationGateway : NotificationGateway" as Notifier <<interface>>
end box

autonumber "<b>[00]</b>"

== Step 1: Period Lock & Audited Override (FR-2.7) ==
Admin -> View : onIssueInvoiceClicked(invoiceNumber)
activate View
View -> Ctrl : issueAndSendInvoice(adminUser, targetInvoice)
activate Ctrl
Ctrl -> Ctrl : authorized = false
Ctrl -> Period : isLocked()
activate Period
Period --> Ctrl : locked
 deactivate Period
alt Financial period locked
    Ctrl --> View : Financial period closed
    View --> Admin : Display period lock warning
    opt SuperAdmin requests explicit exception
        SuperAdmin -> AdminView : onOverridePeriodClicked(fiscalPeriod, reason)
        activate AdminView
        AdminView -> Ctrl : authorizeInvoiceOverride(superAdmin, targetInvoice, reason)
        Ctrl -> Ctrl : validateSuperAdminPermission(superAdmin)
        alt Permission granted
            Ctrl -> Period : grantInvoiceException(targetInvoice, reason)
            activate Period
            Period --> Ctrl : granted
            deactivate Period
            alt Invoice-specific exception granted
                Ctrl -> Ctrl : authorized = true
                ref over Ctrl, Period : DS-BASE: Audit specific period exception
            end
            Ctrl --> AdminView : granted
            AdminView --> SuperAdmin : Display decision
        else Permission denied
            Ctrl --> AdminView : denied
            AdminView --> SuperAdmin : Display authorization error
        end
        deactivate AdminView
    end
else Financial period open
    Ctrl -> Ctrl : authorized = true
end

== Step 2: Issue, Mark SENT & Trigger Company Notification (FR-2.4, FR-4.1.1) ==
alt Invoice operation authorized
    Ctrl -> Ctrl : validateInvoiceForIssuance(targetInvoice)
    alt Invoice valid and status READY
        Ctrl -> Invoice : setIssueDate(today)
        activate Invoice
        Invoice --> Ctrl : completed
        deactivate Invoice
        Ctrl -> Invoice : changeStatus(ISSUED)
        activate Invoice
        Invoice --> Ctrl : true
        deactivate Invoice
        ref over Ctrl, Invoice : DS-BASE: Invoice Issuance Audit & Admin Alert

        Ctrl -> Invoice : changeStatus(SENT)
        activate Invoice
        Invoice --> Ctrl : true
        deactivate Invoice

        note over Invoice
            SENT records the invoice dispatch event.
            Email delivery is tracked separately
            through Notification status.
        end note

        Ctrl -> Notifier : sendNotification(customer.companyEmail, "Invoice sent", invoiceLink)
        activate Notifier
        Notifier --> Ctrl : sent
        deactivate Notifier
        alt Notification sent successfully
            ref over Ctrl, Invoice : DS-BASE: Notification Delivered Audit
            Ctrl --> View : targetInvoice
            View -> View : renderInvoiceDetails(targetInvoice, comments)
            View --> Admin : Display SENT status
        else Notification dispatch failed
            Ctrl -> Ctrl : queueInvoiceNotificationRetry(targetInvoice, customer.companyEmail)
            note over Invoice
                Invoice remains SENT; notification is FAILED
                and will be retried, without reissuing the invoice.
            end note
            ref over Ctrl, Invoice : DS-BASE: Failed Notification Audit
            Ctrl --> View : Invoice marked SENT; email queued for retry
            View --> Admin : Display notification warning
        end
    else Invoice invalid or not READY
        Ctrl --> View : Validation failed
        View --> Admin : Display validation error
    end
else Invoice operation not authorized
    note over Ctrl, Invoice : No invoice mutation occurs without authorization
end

deactivate Ctrl
deactivate View

== Step 3: Accounting Export Package & Audit Metadata (FR-6.3, FR-6.4) ==
Admin -> View : onExportPackageClicked(fiscalPeriod, filters)
activate View
View -> Ctrl : generateAccountingExport(adminUser, fiscalPeriod, filters)
activate Ctrl

opt Bulk export threshold exceeded
    ref over Ctrl, Period : DS-BASE: Alert Administrator of Mass Export Attempt (FR-6.4.2)
end

Ctrl -> Ctrl : version = nextExportVersion(fiscalPeriod)
Ctrl -> Ctrl : generatedPath = generateExportFiles(fiscalPeriod, filters)
create Pkg
Ctrl -> Pkg : <<create>> (exportId, period=fiscalPeriod, version, previousVersion, generatedAt=now(), filePath=generatedPath, requestedBy=adminUser, appliedFilters=filters)
activate Pkg
Pkg --> Ctrl : accountingExport
 deactivate Pkg
ref over Ctrl, Pkg : DS-BASE: Audited Export (user, filters, version, timestamp)
Ctrl --> View : accountingExport
deactivate Ctrl
View -> View : renderExportDownload(accountingExport)
View --> Admin : Display downloadable, versioned package
 deactivate View

== Step 4: Unissued Test Invoice Deletion (FR-2.3.2, FR-2.7) ==
Admin -> View : onDeleteTestInvoiceClicked(testInvoiceNumber)
activate View
View -> Ctrl : deleteTestInvoice(adminUser, testInvoice)
activate Ctrl
Ctrl -> TestInvoice : isEditable()
activate TestInvoice
TestInvoice --> Ctrl : editable
 deactivate TestInvoice
Ctrl -> Period : isLocked()
activate Period
Period --> Ctrl : locked
 deactivate Period
alt Invoice type TEST, status DRAFT, editable, and period unlocked
    ref over Ctrl, TestInvoice : DS-BASE: Audit Test Invoice Deletion
    Ctrl -> TestInvoice : dispose()
    destroy TestInvoice
    Ctrl --> View : deletionSuccessful
    View -> View : renderInvoiceDeleted()
    View --> Admin : Display confirmation
else Deletion is not permitted
    Ctrl --> View : deletionRejected
    View --> Admin : Display restriction
end
 deactivate Ctrl
 deactivate View
@enduml
