@startuml
skinparam boxPadding 10

' Component/Participant styling
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

title Sequence Diagram - Bank Transaction Ingestion & Automated Reconciliation (UC-20, UC-21, UC-22, FR-3.1, FR-3.2, FR-3.3, NFR-2.10)
actor Admin as "adminUser : Admin"
actor Scheduler as "reconciliationScheduler : SystemDaemon"

box "Presentation Layer" #F5F7FA
    participant View as "reconcileView : InvoicingAndReconciliationView" <<boundary>>
end box

box "Application Layer" #EBF0F5
    participant Ctrl as "reconcileCtrl : ReconciliationController" <<control>>
end box

box "Domain Layer" #FFFFFF
    participant Gateway as "bankingGateway : BankingPaymentGateway" <<interface>>
    participant Tx as "bankTx : BankTransaction"
    participant Invoice as "matchedInvoice : Invoice"
    participant Alloc as "paymentAlloc : PaymentAllocation"
    participant ManualAlloc as "manualPaymentAlloc : PaymentAllocation"
    participant Cust as "customerAccount : Customer"
end box

box "Infrastructure Layer" #F5F7FA
    participant Adapter as "bankingAdapter : BankingApiAdapter" <<infrastructure>>
end box

' --- SEQUENCE FLOW ---

autonumber "<b>[00]</b>"


== Step 1: Banking API Transaction Ingestion (UC-21, FR-3.1) ==

Scheduler -> Ctrl : runAutomatedReconciliation()
activate Ctrl

Ctrl -> Gateway : fetchTransactionsSince(checkpointTimestamp)
activate Gateway

Gateway -> Adapter : fetchTransactionsSince(checkpointTimestamp)
activate Adapter

note over Adapter
    Retrieves bank transactions.
    Supports simulated Stripe mode (NFR-2.10).
end note

alt Banking API unavailable or returns an error

    Adapter --> Gateway : integrationError
    deactivate Adapter

    Gateway --> Ctrl : integrationError
    deactivate Gateway

    ref over Ctrl, Gateway : DS-BASE: Banking Integration Error Alert (FR-4.2.2)

else Transactions retrieved successfully

    Adapter --> Gateway : transactionsList
    deactivate Adapter

    Gateway --> Ctrl : transactionsList
    deactivate Gateway

    == Step 2: Automated Payment Reconciliation (UC-20, FR-3.2, FR-3.3) ==

    loop For each bankTx in transactionsList

        Ctrl -> Ctrl : findMatchingInvoices(bankTx.reference, bankTx.amount, metadata)

        alt Duplicate, ambiguous, delayed or unmatched transaction

            Ctrl -> Tx : setStatus("UNMATCHED")
            activate Tx
            Tx --> Ctrl : completed
            deactivate Tx

            ref over Ctrl, Tx : DS-BASE: Alert Administrator of Unmatched Transaction (FR-4.2.2)

        else Unique invoice match found

            Ctrl -> Ctrl : remainingBalance = calculateRemainingBalance(matchedInvoice)

            Ctrl -> Ctrl : validatePaymentAmount(bankTx, remainingBalance)

            alt Payment invalid, already processed or exceeds remaining balance

                Ctrl -> Tx : setStatus("UNMATCHED")
                activate Tx
                Tx --> Ctrl : completed
                deactivate Tx

                ref over Ctrl, Tx : DS-BASE: Payment Exception Audit & Alert

            else Valid payment

                Ctrl -> Ctrl : allocatePayment(bankTx, matchedInvoice, bankTx.amount)

                create Alloc
                Ctrl -> Alloc : <<create>> (bankTx, matchedInvoice, bankTx.amount, today)
                activate Alloc
                Alloc --> Ctrl : paymentAlloc
                deactivate Alloc

                Ctrl -> Tx : setStatus("MATCHED")
                activate Tx
                Tx --> Ctrl : completed
                deactivate Tx

                Ctrl -> Ctrl : remainingBalance = calculateRemainingBalance(matchedInvoice)

                alt Remaining invoice balance is zero

                    Ctrl -> Invoice : changeStatus(PAID)
                    activate Invoice
                    Invoice --> Ctrl : true
                    deactivate Invoice

                    opt Customer has no other overdue or unpaid invoices
                        Ctrl -> Cust : setStanding(UP_TO_DATE)
                        activate Cust
                        Cust --> Ctrl : completed
                        deactivate Cust
                    end

                    ref over Ctrl, Invoice : DS-BASE: Invoice Paid Notification & Audit (FR-4.2.1)

                else Remaining invoice balance is greater than zero

                    Ctrl -> Invoice : changeStatus(PARTIALLY_RECONCILED)
                    activate Invoice
                    Invoice --> Ctrl : true
                    deactivate Invoice

                    ref over Ctrl, Invoice : DS-BASE: Partial Payment Audit

                end
            end
        end
    end

    Ctrl -> Ctrl : updateTransactionCheckpoint()

end

deactivate Ctrl


== Step 3: Manual Administrator Review & Resolution (UC-22, FR-3.3) ==

Admin -> View : onResolveUnmatchedClicked(bankTxId, selectedInvoiceId)
activate View

View -> Ctrl : resolveUnmatchedTransaction(adminUser, bankTx, matchedInvoice)
activate Ctrl

Ctrl -> Ctrl : validateManualResolution(adminUser, bankTx, matchedInvoice)

alt Transaction unmatched, administrator authorized and amount valid

    Ctrl -> Ctrl : allocatePayment(bankTx, matchedInvoice, bankTx.amount)

    create ManualAlloc
    Ctrl -> ManualAlloc : <<create>> (bankTx, matchedInvoice, bankTx.amount, today)
    activate ManualAlloc
    ManualAlloc --> Ctrl : manualPaymentAlloc
    deactivate ManualAlloc

    Ctrl -> Tx : setStatus("MATCHED")
    activate Tx
    Tx --> Ctrl : completed
    deactivate Tx

    Ctrl -> Ctrl : remainingBalance = calculateRemainingBalance(matchedInvoice)

    alt Remaining invoice balance is zero

        Ctrl -> Invoice : changeStatus(PAID)
        activate Invoice
        Invoice --> Ctrl : true
        deactivate Invoice

        opt Customer has no other overdue or unpaid invoices
            Ctrl -> Cust : setStanding(UP_TO_DATE)
            activate Cust
            Cust --> Ctrl : completed
            deactivate Cust
        end

        ref over Ctrl, Invoice : DS-BASE: Invoice Paid Notification & Audit (FR-4.2.1)

    else Remaining invoice balance is greater than zero

        Ctrl -> Invoice : changeStatus(PARTIALLY_RECONCILED)
        activate Invoice
        Invoice --> Ctrl : true
        deactivate Invoice

        ref over Ctrl, Invoice : DS-BASE: Partial Payment Audit

    end

    Ctrl --> View : Resolution successful
    View -> View : renderUnmatchedPayments(remainingQueue)
    View --> Admin : Display successful reconciliation

else Resolution not permitted

    Ctrl --> View : Resolution rejected
    View --> Admin : Display validation error

end

deactivate Ctrl
deactivate View


@enduml

