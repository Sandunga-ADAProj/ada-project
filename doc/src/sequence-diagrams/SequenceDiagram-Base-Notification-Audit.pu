@startuml
skinparam boxPadding 10
skinparam participantPadding 10

' Component/Participant styling
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

title Sequence Diagram - Base Transversal: Notification Dispatch & Audit Trail (FR-4.1, FR-4.2, FR-5.4)

' DS-BASE is a reusable sequence referenced by the other diagrams.
' ApplicationController and DomainEntity are generic placeholders,
' not concrete classes from the Class Diagram.
' ChangeHistoryRecord represents a persistent audit record.
' NotificationGateway is implemented by NotificationServiceAdapter.

box "Application Layer" #EBF0F5
    ' <<abstract>> — stands for any concrete ApplicationController (see ComponentsDiagram)
    participant Ctrl as "callerCtrl : ApplicationController" <<control>>
end box

box "Domain Layer" #FFFFFF
    ' <<abstract>> — stands for any concrete domain entity (see ComponentsDiagram domain components)
    participant Entity as "domainEntity : DomainEntity"
    ' ChangeHistoryRecord: cross-cutting audit value object (see ComponentsDiagram note)
    participant Log as "auditRecord : ChangeHistoryRecord"
    ' NotificationGateway: domain port implemented by NotificationServiceAdapter (ComponentsDiagram)
    participant Notifier as "notificationGateway : NotificationGateway" <<interface>>
    ' Notification: dispatch record created before synchronous send
    participant Notif as "notification : Notification"
end box

box "Infrastructure Layer" #F5F7FA
    ' NotificationServiceAdapter implements NotificationGateway port (ComponentsDiagram)
    participant Adapter as "notificationAdapter : NotificationServiceAdapter" <<infrastructure>>
end box

' --- SEQUENCE FLOW ---

autonumber "<b>[00]</b>"


== Step 1: Domain State Change & Audit Trail ==

opt Business event modifies a domain entity

    Ctrl -> Entity : executeStateTransition(newState, actorId)
    activate Entity

    Entity --> Ctrl : mutationResult
    deactivate Entity

    alt State change successful

        create Log
        Ctrl -> Log : <<create>> (entityId, changeType, actorId, timestamp, previousValue, newValue)
        activate Log

        Log --> Ctrl : auditRecord
        deactivate Log

        Ctrl -> Ctrl : persistAuditRecord(auditRecord)

        note over Log
            Audit record includes:
            - Affected entity
            - Acting user
            - Timestamp
            - Previous value
            - New value

            Retained according to legal
            and accounting requirements.
        end note

    else State change rejected

        Ctrl -> Ctrl : recordRejectedOperation(actorId, reason)

    end

end


== Step 2: Notification Dispatching (FR-4.1, FR-4.2) ==

opt Business event requires notification

    create Notif
    Ctrl -> Notif : <<create>> (notificationId, type, status=PENDING)
    activate Notif
    Notif --> Ctrl : notification
    deactivate Notif

    Ctrl -> Notifier : sendNotification(recipientEmail, subject, body)
    activate Notifier

    Notifier -> Adapter : sendNotification(recipientEmail, subject, body)
    activate Adapter

    note over Adapter
        Sends email through SMTP
        or an external notification service.
    end note

    Adapter --> Notifier : sent
    deactivate Adapter

    Notifier --> Ctrl : sent
    deactivate Notifier

    alt Notification successfully sent

        Ctrl -> Notif : setStatus(SENT)
        activate Notif
        Notif --> Ctrl : completed
        deactivate Notif

        Ctrl -> Notif : setSentAt(now())
        activate Notif
        Notif --> Ctrl : completed
        deactivate Notif

    else Notification sending failed

        Ctrl -> Notif : setStatus(FAILED)
        activate Notif
        Notif --> Ctrl : completed
        deactivate Notif

        Ctrl -> Ctrl : scheduleNotificationRetry(notification)

        note over Notif
            Notification remains recorded.
            Sending can be retried without
            losing the notification history.
        end note

    end

end


@enduml
