@startuml
hide circle
hide empty fields
hide <<enum>> empty members
skinparam classAttributeIconSize 0

' Class styling
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
    FontName monospace
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

' ==========================================
' 1) PRESENTATION LAYER (BOUNDARIES)
' ==========================================
package "com.invoicingsystem.presentation" {
    class PortalDashboardSummaryView <<boundary>> {
        + renderLoginForm(): void
        + onLoginClicked(email: String, password: String): void
        + renderDashboardSummary(dashboard: DashboardSummary): void
        + renderSearchResults(records: List<SearchResult>): void
        + onSearchClicked(query: String, entityType: String): void
        + onSavePreferencesClicked(prefs: UserPreferences): void
    }

    class CustomerManagementView <<boundary>> {
        + renderRegistrationForm(): void
        + onRegisterCustomerClicked(legalName: String, taxId: String, country: String, companyEmail: String): void
        + renderContactsList(contacts: List<Contact>): void
        + renderSubscriptionSetup(plans: List<BillingPlan>): void
        + onRequestCancellationClicked(customerId: String, reason: String): void
        + onProcessCancellationClicked(requestId: String, approved: boolean): void
    }

    class InvoicingAndReconciliationView <<boundary>> {
        + renderInvoiceDetails(invoice: Invoice, comments: List<Comment>): void
        + onIssueInvoiceClicked(invoiceNumber: String): void
        + onAddCommentClicked(invoiceNumber: String, text: String): void
        + renderUnmatchedPayments(transactions: List<BankTransaction>): void
        + onExportPackageClicked(period: FinancialPeriod): void
    }

    class SystemAdministrationView <<boundary>> {
        + renderPricingConfiguration(plans: List<BillingPlan>): void
        + renderFlaggedPricesQueue(reviews: List<PriceReview>): void
        + renderUserPermissions(): void
        + onOverridePeriodClicked(period: FinancialPeriod, reason: String): void
    }
}

' ==========================================
' 2) APPLICATION LOGIC LAYER (CONTROLS)
' ==========================================
package "com.invoicingsystem.application" {
    class CustomerAndSubscriptionController <<control>> {
        - notifier: NotificationGateway
        + registerCustomer(admin: Admin, legalName: String, taxId: String, country: String, companyEmail: String): Customer
        + manageContacts(admin: Admin, customer: Customer): boolean
        + anonymizeContactData(admin: Admin, contact: Contact): boolean
        + configureSubscription(admin: Admin, customer: Customer, plan: BillingPlan): Subscription
        + submitCommercialException(user: User, sub: Subscription, type: String, val: BigDecimal): CommercialException
        + approveCommercialException(admin: Admin, exception: CommercialException, approved: boolean): boolean
        + handleCancellationWorkflow(user: User, customer: Customer, reason: String): CancellationRequest
        + processCancellationRequest(admin: Admin, request: CancellationRequest, approved: boolean): boolean
    }

    class InvoicingAndBillingController <<control>> {
        - notifier: NotificationGateway
        - calendarService: BusinessCalendarService
        + executeRecurringBillingBatch(executionDate: LocalDate): void
        + createOrUpdateAdHocInvoice(admin: Admin, customer: Customer): Invoice
        + deleteTestInvoice(admin: Admin, invoice: Invoice): boolean
        + issueAndSendInvoice(admin: Admin, invoice: Invoice): Invoice
        + postInvoiceComment(user: User, invoice: Invoice, text: String): Comment
        + closeFinancialPeriod(admin: Admin, period: FinancialPeriod): boolean
        + overrideLockedPeriod(superAdmin: SuperAdmin, period: FinancialPeriod, reason: String): boolean
        + generateAccountingExport(admin: Admin, period: FinancialPeriod): AccountingExportPackage
    }

    class ReconciliationController <<control>> {
        - bankingGateway: BankingPaymentGateway
        - notifier: NotificationGateway
        + runAutomatedReconciliation(): void
        + resolveUnmatchedTransaction(admin: Admin, tx: BankTransaction, invoice: Invoice): boolean
        + allocatePayment(tx: BankTransaction, invoice: Invoice, amount: BigDecimal): PaymentAllocation
    }

 
    
    class DashboardSummary <<DTO>> {
        + outstandingBalance: BigDecimal
        + pendingInvoices: int
        + unmatchedPayments: int
    }

    class SearchResult <<DTO>> {
        + entityType: String
        + recordId: String
        + displayLabel: String
    }

   class AccessAndConfigController <<control>> {
        + authenticateUser(email: String, password: String): boolean        
        + getDashboardSummary(user: User): DashboardSummary
        + searchRecords(user: User, query: String, entityType: String): List<SearchResult>
        + updateUserPreferences(user: User, prefs: UserPreferences): void
        + delegateAccountAccess(admin: Admin, originalAssignee: User, grantee: User, scope: Customer, validUntil: LocalDate): AccountDelegation
        + revokeAccountDelegation(admin: Admin, delegation: AccountDelegation): boolean
        + provisionGuestAccount(admin: Admin, email: String, validUntil: LocalDate): User
        + updateStandardPricingAndTargets(superAdmin: SuperAdmin, plan: BillingPlan): boolean
        + updateUserPermissions(superAdmin: SuperAdmin, user: User, permissions: Set<String>): boolean
        + manageBusinessRule(superAdmin: SuperAdmin, rule: BusinessRule): boolean  
   }        
}

' ==========================================
' 3) CORE DOMAIN LAYER (ENTITIES & CONTRACTS)
' ==========================================
package "com.invoicingsystem.domain" {

    ' --- Enumerations ---
    
    enum UserState {
        ACTIVE
        INACTIVE
        BLOCKED
    }

    enum SubscriptionStatus {
        PENDING_ACTIVATION
        ACTIVE
        SUSPENDED
        CANCELLED
    }


    enum AccountStanding <<enum>> {
        UP_TO_DATE
        OVERDUE
        SUSPENDED
        IN_DISPUTE
    }

    enum ContactState <<enum>> {
        ACTIVE
        INACTIVE
        ANONYMIZED
    }

    enum InvoiceStatus <<enum>> {
        DRAFT
        READY
        ISSUED
        SENT
        OVERDUE
        PAID
        PARTIALLY_RECONCILED
    }

    enum InvoiceType <<enum>> {
        RECURRING
        ONE_OFF
        TEST
    }

    enum ApprovalStatus <<enum>> {
        PENDING
        APPROVED
        REJECTED
    }
    
    enum CustomerStatus {
        PENDING_VERIFICATION
        ACTIVE
        SUSPENDED
        CANCELLED
    }
    
    enum DelegationStatus {
        ACTIVE
        EXPIRED
        REVOKED
    }    
  
    class UserPreferences {
        - language: String
        - fontScale: double
        - highContrast: boolean
    }
    
    class AccountDelegation {
        - delegationId: String
        - startDate: LocalDate
        - validUntil: LocalDate
        - status: DelegationStatus
        + isActive(date: LocalDate): boolean
        + expire(): void
        + revoke(): void
    }


    class PriceReview {
        - reviewId: String
        - proposedPrice: BigDecimal
        - reason: String
        - status: ApprovalStatus
        + approve(): void
        + reject(): void
    }

    class NotificationRule {
        - ruleId: String
        - triggerType: String
        - delayDays: int
        - enabled: boolean
    }

    class BusinessRule {
        - ruleId: String
        - name: String
        - value: String
        - enabled: boolean
    }
    class AccountingExportPackage {
            - exportId: String
            - version: int
            - generatedAt: LocalDateTime
            - filePath: String
    }




    ' --- Domain Interfaces (Contracts dictated by the business) ---
    interface BankingPaymentGateway <<interface>> {
        + fetchTransactionsSince(checkpoint: LocalDateTime): List<BankTransaction>
        + testConnection(): boolean
    }

    interface NotificationGateway <<interface>> {
        + sendNotification(recipientEmail: String, subject: String, body: String): boolean
        + scheduleReminder(invoiceNumber: String, sendDate: LocalDate): boolean
    }

    interface BusinessCalendarService <<interface>> {
        + isWorkingDay(date: LocalDate, country: String): boolean
        + getNextWorkingDay(date: LocalDate, country: String): LocalDate
    }

    ' --- Entities ---
    class User {
        - userId: String
        - email: String
        - passwordHash: String
        - state: UserState
        - permissions: Set<String>
        + configureUserPreferences(prefs: UserPreferences): void
        + addComment(invoice: Invoice, text: String): Comment
        + proposeCommercialException(sub: Subscription, type: String, value: BigDecimal): CommercialException
        + requestAccCancellation(customer: Customer, reason: String): CancellationRequest
    }

    class Admin {
        + registerCustomerProfile(legalName: String, taxId: String, country: String, companyEmail: String): Customer        
        + manageCustomerContacts(customer: Customer): boolean
        + anonymizeContactData(contact: Contact): boolean
        + setUpSubsPlan(customer: Customer, plan: BillingPlan): Subscription
        + approveCommercialEx(ex: CommercialException): boolean
        + reviewFlaggedPrices(): List<PriceReview>
        + manageAdHocInvoice(customer: Customer): Invoice
        + exportAccPackage(period: FinancialPeriod): AccountingExportPackage
        + issueInvoice(invoice: Invoice): Invoice
        + lockFinancialPeriod(period: FinancialPeriod): boolean
        + reviewUnmatchedPayment(tx: BankTransaction, invoice: Invoice): boolean
        + configNotificationTriggers(rule: NotificationRule): boolean
        + processAccCancellation(req: CancellationRequest): boolean
        + authorizeAccountDelegation(delegation: AccountDelegation): boolean
        + provisionGuestAccount(email: String, validUntil: LocalDate): User
    }

    class SuperAdmin {
        + configStandardPricing(plan: BillingPlan): boolean
        + configStandardTargets(month: YearMonth, target: BigDecimal): boolean
        + configureUserPermissions(user: User, permissions: Set<String>): boolean        
        + manageSystemRules(rule: BusinessRule): boolean
        + overrideLockedPeriod(period: FinancialPeriod, reason: String): boolean    
}

    class Customer {
        - customerId: String
        - commercialName: String
        - tradingName: String
        - legalName: String
        - taxId: String
        - taxAddress: String
        - country: String
        - currency: String
        - companyEmail: String
        - emailVerified: boolean
        - status: CustomerStatus
        - standing: AccountStanding
        - tags: List<String>
        + addContact(contact: Contact): Contact
        + deactivateContact(contact: Contact): boolean
        + hasCompleteTaxInfo(): boolean
        + getOutstandingBalance(): BigDecimal
    }

    class Contact {
        - contactId: String
        - name: String
        - email: String
        - phone: String
        - isBillingContact: boolean
        - state: ContactState
        + anonymize(): void
    }

    class BillingPlan {
        - name: String
        - basePrice: BigDecimal
        - minPrice: BigDecimal
        - maxPrice: BigDecimal
    }

    class Subscription {
        - subscriptionId: String
        - startDate: LocalDate
        - billingAnchorDay: int
        - paymentTermsDays: int
        - price: BigDecimal
        - status: SubscriptionStatus
        + activate(): boolean
    }

    class Invoice {
        - invoiceNumber: String
        - type: InvoiceType
        - status: InvoiceStatus
        - issueDate: LocalDate
        - dueDate: LocalDate
        - subtotal: BigDecimal
        - vatAmount: BigDecimal
        - total: BigDecimal
        + changeStatus(newStatus: InvoiceStatus): boolean
        + isEditable(): boolean
    }

    class InvoiceLine {
        - description: String
        - quantity: int
        - unitPrice: BigDecimal
        - taxRate: BigDecimal
    }

    class Comment {
        - text: String
        - createdAt: LocalDateTime
    }

    class CommercialException {
        - type: String
        - value: BigDecimal
        - startDate: LocalDate
        - endDate: LocalDate
        - status: ApprovalStatus
        + approve(): void
        + reject(): void
    }

    class CancellationRequest {
        - requestDate: LocalDate
        - reason: String
        - outstandingBalance: BigDecimal
        - status: ApprovalStatus
        + approve(): void
        + reject(): void
    }

    class BankTransaction {
        - reference: String
        - amount: BigDecimal
        - valueDate: LocalDate
        - status: String
    }

    class FinancialPeriod {
        - startDate: LocalDate
        - endDate: LocalDate
        - locked: boolean
        + lock(): void
        + overrideLock(reason: String): void
        + isLocked(): boolean
    }
    
    
    class PaymentAllocation {
        - allocatedAmount: BigDecimal
        - allocationDate: LocalDate

        + validateAmount(): boolean
    }


    class Notification {
        - notificationId: String
        - type: String
        - status: String
        - scheduledAt: LocalDateTime
        - sentAt: LocalDateTime
    }

}

' ==========================================
' 4) INFRASTRUCTURE LAYER (EXTERNAL ADAPTERS)
' ==========================================
package "com.invoicingsystem.infrastructure" {
    class BankingApiAdapter {
        - apiEndpointUrl: String
        - apiKey: String
        - simulatedStripeMode: boolean
        + fetchTransactionsSince(checkpoint: LocalDateTime): List<BankTransaction>
        + testConnection(): boolean
        - parseBankPayload(rawJson: String): List<BankTransaction>
    }

    class NotificationServiceAdapter {
        - smtpHost: String
        - gatewayApiKey: String
        + sendNotification(recipientEmail: String, subject: String, body: String): boolean
        + scheduleReminder(invoiceNumber: String, sendDate: LocalDate): boolean
    }

    class RegionalCalendarAdapter {
        - defaultRegion: String
        + isWorkingDay(date: LocalDate, country: String): boolean
        + getNextWorkingDay(date: LocalDate, country: String): LocalDate
    }
}

' ==========================================
' RELATIONSHIPS & TRAFFIC BETWEEN PACKAGES
' ==========================================

' Boundary to Control links
PortalDashboardSummaryView .down.> AccessAndConfigController
CustomerManagementView .down.> CustomerAndSubscriptionController
InvoicingAndReconciliationView .down.> InvoicingAndBillingController
InvoicingAndReconciliationView .down.> ReconciliationController
SystemAdministrationView .down.> AccessAndConfigController
SystemAdministrationView .down.> InvoicingAndBillingController

' Control orchestrating Domain Entities & Gateways
CustomerAndSubscriptionController .down.> Customer
CustomerAndSubscriptionController .down.> Subscription
CustomerAndSubscriptionController .down.> NotificationGateway

InvoicingAndBillingController .down.> Invoice
InvoicingAndBillingController .down.> FinancialPeriod
InvoicingAndBillingController .down.> NotificationGateway
InvoicingAndBillingController .down.> BusinessCalendarService

ReconciliationController .down.> BankTransaction
ReconciliationController .down.> Invoice
ReconciliationController .down.> BankingPaymentGateway

AccessAndConfigController .down.> User
AccessAndConfigController .down.> BillingPlan
AccessAndConfigController .down.> AccountDelegation
AccessAndConfigController .down.> DashboardSummary
AccessAndConfigController .down.> SearchResult

' Infrastructure Implementation (Plugs into Domain Ports)
BankingPaymentGateway <|.. BankingApiAdapter
NotificationGateway <|.. NotificationServiceAdapter
BusinessCalendarService <|.. RegionalCalendarAdapter

' Inheritance Mapping
User <|-- Admin
Admin <|-- SuperAdmin

' Refined Domain Structural Relationships
User "0..*" --> "0..*" Customer : " -assignedCustomers"
User "1" --> "0..*" CancellationRequest : " -submittedRequests"
User "1" *-- "0..1" UserPreferences : preferences

Customer "1" *-- "1..*" Contact : " -contacts"
Customer "1" --> "0..*" Subscription : " -subscriptions"
Customer "1" --> "0..*" Invoice : " -invoices"
Customer "1" --> "0..*" CancellationRequest : " -cancellationRequests"

Subscription "0..*" --> "1" BillingPlan : " -plan"
Subscription "1" --> "0..*" CommercialException : " -exceptions"
Invoice "1" *-- "0..*" InvoiceLine : " -lines"
Invoice "1" *-- "0..*" Comment : " -comments"
Invoice "0..*" --> "1" FinancialPeriod : " -period"

Comment "0..*" --> "1" User : " -author"
Comment "0..*" --> "0..*" User : " -mentions"

BankTransaction "1" -- "0..*" PaymentAllocation : " -allocations"
Invoice "1" -- "0..*" PaymentAllocation : " -paymentAllocations"


Subscription "0..1" --> "0..*" Invoice : " -generatedInvoices"


User "1" --> "0..*" CommercialException : " -proposedExceptions"

Admin "0..1" --> "0..*" CommercialException : " -reviewedExceptions"

Admin "0..1" --> "0..*" CancellationRequest : " -processedRequests"

Admin "0..1" --> "0..*" FinancialPeriod : " -lockedPeriods"

Admin "0..1" --> "0..*" BankTransaction : " -reviewedTransactions"

SuperAdmin "0..1" --> "0..*" FinancialPeriod : " -overriddenPeriods"

SuperAdmin "0..*" --> "0..*" BillingPlan : " -configuredPlans"


Notification "0..*" --> "0..1" User : " -internalRecipient"
Notification "0..*" --> "0..1" Contact : " -customerRecipient"
Notification "0..*" --> "0..1" Invoice : " -relatedInvoice"


AccountDelegation "0..*" --> "1" User : originalAssignee

AccountDelegation "0..*" --> "1" User : delegatedTo

AccountDelegation "0..*" --> "1" Customer : customerScope

AccountDelegation "0..*" --> "1" Admin : authorizedBy


note bottom of Notification
    Each notification must have exactly one recipient:
    either an internal User or a customer Contact.
    The related Invoice is optional.
end note

note bottom of AccountDelegation
    The original assignee must already manage
    the customer account.
    The delegation must have a valid expiration date.
    Expired or revoked delegations grant no access.
    The original assignment remains unchanged.
end note



BillingPlan "1" --> "0..*" PriceReview : price reviews

Admin "0..*" --> "0..*" NotificationRule : configures

SuperAdmin "0..*" --> "0..*" BusinessRule : manages




@enduml